{{!-- Homepage card. size="feature" shows a large image and excerpt; anything else is a compact row.
     label replaces the primary tag eyebrow, because every post shares the same tags. --}}
<article class="pz-hc{{#match size "feature"}} pz-hc-feature{{/match}}">
    <a class="pz-hc-link" href="{{url}}">
        <figure class="pz-media pz-hc-media">
            {{#if feature_image}}
                {{#match size "feature"}}
                    <img srcset="{{img_url feature_image size="s" format="webp"}} 300w, {{img_url feature_image size="m" format="webp"}} 720w"
                         sizes="(min-width: 1080px) 340px, (min-width: 640px) 46vw, 100vw"
                         src="{{img_url feature_image size="m" format="webp"}}"
                         alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" width="720" height="405" loading="lazy" decoding="async">
                {{else}}
                    <img srcset="{{img_url feature_image size="xs" format="webp"}} 150w, {{img_url feature_image size="s" format="webp"}} 300w"
                         sizes="112px" src="{{img_url feature_image size="s" format="webp"}}"
                         alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" width="300" height="169" loading="lazy" decoding="async">
                {{/match}}
            {{/if}}
        </figure>
        <div class="pz-hc-body">
            {{#if label}}<span class="pz-eyebrow">{{label}}</span>{{/if}}
            <h3 class="pz-hc-title">{{title}}</h3>
            {{#match size "feature"}}{{#if excerpt}}<p class="pz-hc-excerpt">{{excerpt words="22"}}</p>{{/if}}{{/match}}
            <span class="pz-hc-meta">Updated <time datetime="{{date updated_at format="YYYY-MM-DD"}}">{{date updated_at format="MMM YYYY"}}</time> · {{reading_time}}</span>
        </div>
    </a>
</article>
