        <button class="pz-pk pz-pk-b" type="button" data-note="68" data-oct="1" style="--i:5" aria-label="G sharp 4"><kbd class="pz-pk-kbd"></kbd></button>
        <button class="pz-pk pz-pk-b" type="button" data-note="70" data-oct="1" style="--i:6" aria-label="A sharp 4"><kbd class="pz-pk-kbd"></kbd></button>
        <button class="pz-pk pz-pk-b" type="button" data-note="73" data-oct="2" style="--i:8" aria-label="C sharp 5"><kbd class="pz-pk-kbd"></kbd></button>
        <button class="pz-pk pz-pk-b" type="button" data-note="75" data-oct="2" style="--i:9" aria-label="D sharp 5"><kbd class="pz-pk-kbd"></kbd></button>
