{
    "name": "pianoers",
    "description": "Custom Ghost theme for Pianoers.com: playable piano, ear trainer, piano finder, verdict cards, reading progress and affiliate-safe buy buttons.",
    "version": "1.1.3",
    "license": "MIT",
    "author": {
        "name": "Pianoers.com",
        "email": "info@pianoers.com",
        "url": "https://pianoers.com"
    },
    "engines": {
        "ghost": ">=5.0.0"
    },
    "keywords": [
        "ghost-theme"
    ],
    "config": {
        "posts_per_page": 12,
        "image_sizes": {
            "xs": {
                "width": 150
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 720
            },
            "l": {
                "width": 960
            },
            "xl": {
                "width": 1200
            },
            "xxl": {
                "width": 2000
            }
        },
        "card_assets": true,
        "custom": {
            "color_scheme": {
                "type": "select",
                "options": [
                    "Light",
                    "Auto",
                    "Dark"
                ],
                "default": "Light"
            },
            "dark_mode_logo": {
                "type": "image"
            },
            "header_button_text": {
                "type": "text",
                "default": "Find your piano"
            },
            "header_button_url": {
                "type": "text",
                "default": "/best-beginner-pianos/#finder"
            },
            "email_signup_title": {
                "type": "text",
                "default": "Get beginner piano tips by email"
            },
            "email_signup_text": {
                "type": "text",
                "default": "One short email when there's something worth knowing: new gear tests, price drops and practice advice."
            },
            "footer_text": {
                "type": "text"
            },
            "homepage_heading": {
                "type": "text",
                "default": "Honest piano advice from a real teacher",
                "group": "homepage"
            },
            "homepage_sections": {
                "type": "text",
                "default": "pianos, courses, care",
                "group": "homepage"
            },
            "affiliate_disclosure": {
                "type": "text",
                "default": "Some links on this page are affiliate links. If you buy through one, we may earn a small commission at no extra cost to you. It never decides what we recommend.",
                "group": "post"
            },
            "affiliate_domains": {
                "type": "text",
                "default": "amzn.to, amazon.com, sjv.io, clickbank.net, /PFA, /pianoforall, /pbp",
                "group": "post"
            },
            "show_table_of_contents": {
                "type": "boolean",
                "default": true,
                "group": "post"
            },
            "show_sticky_buy_bar": {
                "type": "boolean",
                "default": true,
                "group": "post"
            },
            "show_author_box": {
                "type": "boolean",
                "default": true,
                "group": "post"
            },
            "show_related_posts": {
                "type": "boolean",
                "default": true,
                "group": "post"
            },
            "enable_piano_sounds": {
                "type": "boolean",
                "default": true
            },
            "enable_animations": {
                "type": "boolean",
                "default": true
            },
            "homepage_ear_game": {
                "type": "boolean",
                "default": true,
                "group": "homepage"
            },
            "ear_game_link": {
                "type": "text",
                "default": "/best-piano-lessons-online/",
                "group": "homepage"
            },
            "show_reading_progress": {
                "type": "boolean",
                "default": true,
                "group": "post"
            }
        }
    }
}