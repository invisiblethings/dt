{{!< default}}
<section class="pz-wrap pz-listing">
    <header class="pz-listing-head">
        <h1 class="pz-title">{{#is "home"}}Latest{{else}}All articles{{/is}}</h1>
    </header>
    <div class="pz-grid">
        {{#foreach posts}}{{> "post-card" eager=@first}}{{/foreach}}
    </div>
    {{pagination}}
</section>
