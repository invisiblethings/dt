{"piano-finger-numbers": [820, "<!doctype html><html><head><meta charset=\"utf-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,500;1,500&family=Noto+Music&display=swap\" rel=\"stylesheet\">\n<style>*{box-sizing:border-box;margin:0}\nbody{width:1200px;height:820px;font-family:\"Schibsted Grotesk\",Arial,sans-serif;background:#f3f6f7;color:#15191c;padding:52px 60px 0;position:relative;overflow:hidden}\n.eyebrow{font-size:20px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2e6475}\nh1{font-size:48px;line-height:1.05;font-weight:800;letter-spacing:-.01em;margin:8px 0 26px}\n.foot{position:absolute;left:60px;right:60px;bottom:20px;display:flex;justify-content:space-between;font-size:17px;color:#56666e;font-weight:500}\n.foot b{letter-spacing:.12em;color:#2e6475}\n.card{background:#fff;border:1px solid #d9e2e5;border-radius:20px;box-shadow:0 1px 2px rgb(21 25 28/6%),0 8px 24px rgb(21 25 28/6%)}\nsvg text{font-family:\"Schibsted Grotesk\",Arial,sans-serif}\n.mus{font-family:\"Noto Music\",serif}\n</style></head><body><div class=\"eyebrow\">Finger numbers</div><h1>Fingers 1 to 5, both hands</h1><div class=\"card\" style=\"padding:10px 20px\"><svg width=\"1080\" height=\"470\" viewBox=\"0 0 1080 470\"><rect x=\"190\" y=\"250\" width=\"220\" height=\"170\" rx=\"70\" fill=\"#fff3d1\" stroke=\"#b8a07a\" stroke-width=\"3\"/><g transform=\"rotate(38 392 300)\"><rect x=\"372.0\" y=\"230\" width=\"40\" height=\"100\" rx=\"20.0\" fill=\"#fff3d1\" stroke=\"#b8a07a\" stroke-width=\"3\"/></g><g transform=\"rotate(6 348 262)\"><rect x=\"329.0\" y=\"144\" width=\"38\" height=\"148\" rx=\"19.0\" fill=\"#fff3d1\" stroke=\"#b8a07a\" stroke-width=\"3\"/></g><g transform=\"rotate(0 304 262)\"><rect x=\"285.0\" y=\"130\" width=\"38\" height=\"162\" rx=\"19.0\" fill=\"#fff3d1\" stroke=\"#b8a07a\" stroke-width=\"3\"/></g><g transform=\"rotate(-5 260 262)\"><rect x=\"241.5\" y=\"142\" width=\"37\" height=\"150\" rx=\"18.5\" fill=\"#fff3d1\" stroke=\"#b8a07a\" stroke-width=\"3\"/></g><g transform=\"rotate(-12 220 262)\"><rect x=\"203.0\" y=\"170\" width=\"34\" height=\"122\" rx=\"17.0\" fill=\"#fff3d1\" stroke=\"#b8a07a\" stroke-width=\"3\"/></g><rect x=\"192\" y=\"300\" width=\"216\" height=\"118\" rx=\"66\" fill=\"#fff3d1\"/><circle cx=\"417.9\" cy=\"266.9\" r=\"21\" fill=\"#2e6475\"/><text x=\"417.9\" y=\"275.9\" text-anchor=\"middle\" font-size=\"26\" font-weight=\"800\" fill=\"#fff\">1</text><circle cx=\"357.4\" cy=\"172.5\" r=\"21\" fill=\"#2e6475\"/><text x=\"357.4\" y=\"181.5\" text-anchor=\"middle\" font-size=\"26\" font-weight=\"800\" fill=\"#fff\">2</text><circle cx=\"304.0\" cy=\"158.0\" r=\"21\" fill=\"#2e6475\"/><text x=\"304.0\" y=\"167.0\" text-anchor=\"middle\" font-size=\"26\" font-weight=\"800\" fill=\"#fff\">3</text><circle cx=\"252.0\" cy=\"170.4\" r=\"21\" fill=\"#2e6475\"/><text x=\"252.0\" y=\"179.4\" text-anchor=\"middle\" font-size=\"26\" font-weight=\"800\" fill=\"#fff\">4</text><circle cx=\"206.7\" cy=\"199.4\" r=\"21\" fill=\"#2e6475\"/><text x=\"206.7\" y=\"208.4\" text-anchor=\"middle\" font-size=\"26\" font-weight=\"800\" fill=\"#fff\">5</text><rect x=\"670\" y=\"250\" width=\"220\" height=\"170\" rx=\"70\" fill=\"#fff3d1\" stroke=\"#b8a07a\" stroke-width=\"3\"/><g transform=\"rotate(-38 688 300)\"><rect x=\"668.0\" y=\"230\" width=\"40\" height=\"100\" rx=\"20.0\" fill=\"#fff3d1\" stroke=\"#b8a07a\" stroke-width=\"3\"/></g><g transform=\"rotate(-6 732 262)\"><rect x=\"713.0\" y=\"144\" width=\"38\" height=\"148\" rx=\"19.0\" fill=\"#fff3d1\" stroke=\"#b8a07a\" stroke-width=\"3\"/></g><g transform=\"rotate(0 776 262)\"><rect x=\"757.0\" y=\"130\" width=\"38\" height=\"162\" rx=\"19.0\" fill=\"#fff3d1\" stroke=\"#b8a07a\" stroke-width=\"3\"/></g><g transform=\"rotate(5 820 262)\"><rect x=\"801.5\" y=\"142\" width=\"37\" height=\"150\" rx=\"18.5\" fill=\"#fff3d1\" stroke=\"#b8a07a\" stroke-width=\"3\"/></g><g transform=\"rotate(12 860 262)\"><rect x=\"843.0\" y=\"170\" width=\"34\" height=\"122\" rx=\"17.0\" fill=\"#fff3d1\" stroke=\"#b8a07a\" stroke-width=\"3\"/></g><rect x=\"672\" y=\"300\" width=\"216\" height=\"118\" rx=\"66\" fill=\"#fff3d1\"/><circle cx=\"662.1\" cy=\"266.9\" r=\"21\" fill=\"#b86a0a\"/><text x=\"662.1\" y=\"275.9\" text-anchor=\"middle\" font-size=\"26\" font-weight=\"800\" fill=\"#fff\">1</text><circle cx=\"722.6\" cy=\"172.5\" r=\"21\" fill=\"#b86a0a\"/><text x=\"722.6\" y=\"181.5\" text-anchor=\"middle\" font-size=\"26\" font-weight=\"800\" fill=\"#fff\">2</text><circle cx=\"776.0\" cy=\"158.0\" r=\"21\" fill=\"#b86a0a\"/><text x=\"776.0\" y=\"167.0\" text-anchor=\"middle\" font-size=\"26\" font-weight=\"800\" fill=\"#fff\">3</text><circle cx=\"828.0\" cy=\"170.4\" r=\"21\" fill=\"#b86a0a\"/><text x=\"828.0\" y=\"179.4\" text-anchor=\"middle\" font-size=\"26\" font-weight=\"800\" fill=\"#fff\">4</text><circle cx=\"873.3\" cy=\"199.4\" r=\"21\" fill=\"#b86a0a\"/><text x=\"873.3\" y=\"208.4\" text-anchor=\"middle\" font-size=\"26\" font-weight=\"800\" fill=\"#fff\">5</text><text x=\"300\" y=\"455\" text-anchor=\"middle\" font-size=\"26\" font-weight=\"800\">Left hand</text><text x=\"780\" y=\"455\" text-anchor=\"middle\" font-size=\"26\" font-weight=\"800\">Right hand</text></svg></div>\n<div class=\"card\" style=\"margin-top:18px;padding:18px 24px;font-size:23px;line-height:1.4\">Both thumbs are <b>1</b> and both little fingers are <b>5</b>. The numbers printed above or below notes in your music tell you which finger to use.</div><div class=\"foot\"><span>Hands seen from above, palms down on the keys</span><b>PIANOERS.COM</b></div></body></html>"], "piano-posture-checklist": [770, "<!doctype html><html><head><meta charset=\"utf-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,500;1,500&family=Noto+Music&display=swap\" rel=\"stylesheet\">\n<style>*{box-sizing:border-box;margin:0}\nbody{width:1200px;height:770px;font-family:\"Schibsted Grotesk\",Arial,sans-serif;background:#f3f6f7;color:#15191c;padding:52px 60px 0;position:relative;overflow:hidden}\n.eyebrow{font-size:20px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2e6475}\nh1{font-size:48px;line-height:1.05;font-weight:800;letter-spacing:-.01em;margin:8px 0 26px}\n.foot{position:absolute;left:60px;right:60px;bottom:20px;display:flex;justify-content:space-between;font-size:17px;color:#56666e;font-weight:500}\n.foot b{letter-spacing:.12em;color:#2e6475}\n.card{background:#fff;border:1px solid #d9e2e5;border-radius:20px;box-shadow:0 1px 2px rgb(21 25 28/6%),0 8px 24px rgb(21 25 28/6%)}\nsvg text{font-family:\"Schibsted Grotesk\",Arial,sans-serif}\n.mus{font-family:\"Noto Music\",serif}\n</style></head><body><div class=\"eyebrow\">Posture</div><h1>How to sit at the piano</h1><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:16px\"><div class=\"card\" style=\"padding:20px 22px;display:flex;gap:16px\"><div style=\"flex:none;width:52px;height:52px;border-radius:14px;background:#1c2226;color:#fff;display:grid;place-items:center;font-size:26px;font-weight:800\">1</div><div><div style=\"font-size:27px;font-weight:800\">Bench height</div><div style=\"font-size:21px;font-family:Lora,serif;line-height:1.4;color:#33424a;margin-top:4px\">Forearms level with the keys, elbows just above them.</div></div></div><div class=\"card\" style=\"padding:20px 22px;display:flex;gap:16px\"><div style=\"flex:none;width:52px;height:52px;border-radius:14px;background:#1c2226;color:#fff;display:grid;place-items:center;font-size:26px;font-weight:800\">2</div><div><div style=\"font-size:27px;font-weight:800\">Distance</div><div style=\"font-size:21px;font-family:Lora,serif;line-height:1.4;color:#33424a;margin-top:4px\">Sit so your elbows sit slightly in front of your body, not tucked in.</div></div></div><div class=\"card\" style=\"padding:20px 22px;display:flex;gap:16px\"><div style=\"flex:none;width:52px;height:52px;border-radius:14px;background:#1c2226;color:#fff;display:grid;place-items:center;font-size:26px;font-weight:800\">3</div><div><div style=\"font-size:27px;font-weight:800\">Seat</div><div style=\"font-size:21px;font-family:Lora,serif;line-height:1.4;color:#33424a;margin-top:4px\">Sit on the front half of the bench, back tall and relaxed.</div></div></div><div class=\"card\" style=\"padding:20px 22px;display:flex;gap:16px\"><div style=\"flex:none;width:52px;height:52px;border-radius:14px;background:#1c2226;color:#fff;display:grid;place-items:center;font-size:26px;font-weight:800\">4</div><div><div style=\"font-size:27px;font-weight:800\">Feet</div><div style=\"font-size:21px;font-family:Lora,serif;line-height:1.4;color:#33424a;margin-top:4px\">Flat on the floor. Right foot near the sustain pedal.</div></div></div><div class=\"card\" style=\"padding:20px 22px;display:flex;gap:16px\"><div style=\"flex:none;width:52px;height:52px;border-radius:14px;background:#1c2226;color:#fff;display:grid;place-items:center;font-size:26px;font-weight:800\">5</div><div><div style=\"font-size:27px;font-weight:800\">Wrists</div><div style=\"font-size:21px;font-family:Lora,serif;line-height:1.4;color:#33424a;margin-top:4px\">Level with your hand, never sagging below the keys.</div></div></div><div class=\"card\" style=\"padding:20px 22px;display:flex;gap:16px\"><div style=\"flex:none;width:52px;height:52px;border-radius:14px;background:#1c2226;color:#fff;display:grid;place-items:center;font-size:26px;font-weight:800\">6</div><div><div style=\"font-size:27px;font-weight:800\">Fingers</div><div style=\"font-size:21px;font-family:Lora,serif;line-height:1.4;color:#33424a;margin-top:4px\">Gently curved, as if holding a small ball. Play on the fingertips.</div></div></div></div><div class=\"card\" style=\"margin-top:16px;padding:16px 22px;font-size:21px;line-height:1.4;background:#fff8e6\">Shoulders loose. If anything aches, stop, shake out your hands and check this list again.</div><div class=\"foot\"><span>Pianoers.com piano basics</span><b>PIANOERS.COM</b></div></body></html>"], "20-minute-piano-practice-plan": [760, "<!doctype html><html><head><meta charset=\"utf-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,500;1,500&family=Noto+Music&display=swap\" rel=\"stylesheet\">\n<style>*{box-sizing:border-box;margin:0}\nbody{width:1200px;height:760px;font-family:\"Schibsted Grotesk\",Arial,sans-serif;background:#f3f6f7;color:#15191c;padding:52px 60px 0;position:relative;overflow:hidden}\n.eyebrow{font-size:20px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2e6475}\nh1{font-size:48px;line-height:1.05;font-weight:800;letter-spacing:-.01em;margin:8px 0 26px}\n.foot{position:absolute;left:60px;right:60px;bottom:20px;display:flex;justify-content:space-between;font-size:17px;color:#56666e;font-weight:500}\n.foot b{letter-spacing:.12em;color:#2e6475}\n.card{background:#fff;border:1px solid #d9e2e5;border-radius:20px;box-shadow:0 1px 2px rgb(21 25 28/6%),0 8px 24px rgb(21 25 28/6%)}\nsvg text{font-family:\"Schibsted Grotesk\",Arial,sans-serif}\n.mus{font-family:\"Noto Music\",serif}\n</style></head><body><div class=\"eyebrow\">Practice</div><h1>A 20-minute daily practice plan</h1><div class=\"card\" style=\"padding:24px 28px\"><div style=\"display:flex;border-radius:14px;overflow:hidden;gap:4px\"><div style=\"flex:3;background:#9fbcc5;height:90px;display:grid;place-items:center;color:#1b1400;font-size:24px;font-weight:800\">3 min</div><div style=\"flex:5;background:#2e6475;height:90px;display:grid;place-items:center;color:#fff;font-size:24px;font-weight:800\">5 min</div><div style=\"flex:7;background:#f6b31e;height:90px;display:grid;place-items:center;color:#1b1400;font-size:24px;font-weight:800\">7 min</div><div style=\"flex:3;background:#b86a0a;height:90px;display:grid;place-items:center;color:#fff;font-size:24px;font-weight:800\">3 min</div><div style=\"flex:2;background:#56666e;height:90px;display:grid;place-items:center;color:#fff;font-size:24px;font-weight:800\">2 min</div></div><div style=\"margin-top:16px\"><div style=\"display:grid;grid-template-columns:22px 160px 90px 1fr;gap:12px;align-items:center;padding:12px 0;border-top:1px solid #d9e2e5\"><span style=\"width:22px;height:22px;border-radius:6px;background:#9fbcc5\"></span><b style=\"font-size:25px\">Warm-up</b><span style=\"font-size:23px;font-weight:800;color:#2e6475\">3 min</span><span style=\"font-size:22px;font-family:Lora,serif;color:#33424a\">Finger exercise or a slow scale</span></div><div style=\"display:grid;grid-template-columns:22px 160px 90px 1fr;gap:12px;align-items:center;padding:12px 0;border-top:1px solid #d9e2e5\"><span style=\"width:22px;height:22px;border-radius:6px;background:#2e6475\"></span><b style=\"font-size:25px\">Reading</b><span style=\"font-size:23px;font-weight:800;color:#2e6475\">5 min</span><span style=\"font-size:22px;font-family:Lora,serif;color:#33424a\">New notes, a few bars of sight-reading</span></div><div style=\"display:grid;grid-template-columns:22px 160px 90px 1fr;gap:12px;align-items:center;padding:12px 0;border-top:1px solid #d9e2e5\"><span style=\"width:22px;height:22px;border-radius:6px;background:#f6b31e\"></span><b style=\"font-size:25px\">Your piece</b><span style=\"font-size:23px;font-weight:800;color:#2e6475\">7 min</span><span style=\"font-size:22px;font-family:Lora,serif;color:#33424a\">Hard bars slowly, hands separately, then together</span></div><div style=\"display:grid;grid-template-columns:22px 160px 90px 1fr;gap:12px;align-items:center;padding:12px 0;border-top:1px solid #d9e2e5\"><span style=\"width:22px;height:22px;border-radius:6px;background:#b86a0a\"></span><b style=\"font-size:25px\">Chords & fun</b><span style=\"font-size:23px;font-weight:800;color:#2e6475\">3 min</span><span style=\"font-size:22px;font-family:Lora,serif;color:#33424a\">Chord shapes, play a song you like</span></div><div style=\"display:grid;grid-template-columns:22px 160px 90px 1fr;gap:12px;align-items:center;padding:12px 0;border-top:1px solid #d9e2e5\"><span style=\"width:22px;height:22px;border-radius:6px;background:#56666e\"></span><b style=\"font-size:25px\">Review</b><span style=\"font-size:23px;font-weight:800;color:#2e6475\">2 min</span><span style=\"font-size:22px;font-family:Lora,serif;color:#33424a\">Play it once through, or record yourself</span></div></div></div><div class=\"card\" style=\"margin-top:16px;padding:16px 22px;font-size:21px\">Five or six days a week beats one long session on Sunday.</div><div class=\"foot\"><span>Pianoers.com piano basics</span><b>PIANOERS.COM</b></div></body></html>"], "learning-piano-timeline-roadmap": [800, "<!doctype html><html><head><meta charset=\"utf-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,500;1,500&family=Noto+Music&display=swap\" rel=\"stylesheet\">\n<style>*{box-sizing:border-box;margin:0}\nbody{width:1200px;height:800px;font-family:\"Schibsted Grotesk\",Arial,sans-serif;background:#f3f6f7;color:#15191c;padding:52px 60px 0;position:relative;overflow:hidden}\n.eyebrow{font-size:20px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2e6475}\nh1{font-size:48px;line-height:1.05;font-weight:800;letter-spacing:-.01em;margin:8px 0 26px}\n.foot{position:absolute;left:60px;right:60px;bottom:20px;display:flex;justify-content:space-between;font-size:17px;color:#56666e;font-weight:500}\n.foot b{letter-spacing:.12em;color:#2e6475}\n.card{background:#fff;border:1px solid #d9e2e5;border-radius:20px;box-shadow:0 1px 2px rgb(21 25 28/6%),0 8px 24px rgb(21 25 28/6%)}\nsvg text{font-family:\"Schibsted Grotesk\",Arial,sans-serif}\n.mus{font-family:\"Noto Music\",serif}\n</style></head><body><div class=\"eyebrow\">Your first year</div><h1>A realistic piano roadmap</h1><div style=\"display:flex;flex-direction:column;gap:16px\"><div style=\"display:grid;grid-template-columns:150px 30px 1fr;gap:16px;align-items:start\"><div style=\"font-size:28px;font-weight:800;color:#2e6475;text-align:right;padding-top:6px\">Week 1</div><div style=\"position:relative;height:100%\"><span style=\"position:absolute;left:5px;top:12px;width:20px;height:20px;border-radius:50%;background:#2e6475\"></span><span style=\"position:absolute;left:14px;top:34px;bottom:-26px;width:3px;background:#d9e2e5\"></span></div><div class=\"card\" style=\"padding:14px 18px;font-size:21px;font-family:Lora,serif;line-height:1.4\">Find middle C and every key name. Sit well. Play C position melodies (Ode to Joy) with each hand.</div></div><div style=\"display:grid;grid-template-columns:150px 30px 1fr;gap:16px;align-items:start\"><div style=\"font-size:28px;font-weight:800;color:#2e6475;text-align:right;padding-top:6px\">Month 1</div><div style=\"position:relative;height:100%\"><span style=\"position:absolute;left:5px;top:12px;width:20px;height:20px;border-radius:50%;background:#2e6475\"></span><span style=\"position:absolute;left:14px;top:34px;bottom:-26px;width:3px;background:#d9e2e5\"></span></div><div class=\"card\" style=\"padding:14px 18px;font-size:21px;font-family:Lora,serif;line-height:1.4\">Read treble and bass notes in C position. Count quarter, half and whole notes. Play C, F and G chords.</div></div><div style=\"display:grid;grid-template-columns:150px 30px 1fr;gap:16px;align-items:start\"><div style=\"font-size:28px;font-weight:800;color:#2e6475;text-align:right;padding-top:6px\">Month 3</div><div style=\"position:relative;height:100%\"><span style=\"position:absolute;left:5px;top:12px;width:20px;height:20px;border-radius:50%;background:#2e6475\"></span><span style=\"position:absolute;left:14px;top:34px;bottom:-26px;width:3px;background:#d9e2e5\"></span></div><div class=\"card\" style=\"padding:14px 18px;font-size:21px;font-family:Lora,serif;line-height:1.4\">Hands together on easy pieces. C, G and F major scales. First pedal use. Simple songs with chords.</div></div><div style=\"display:grid;grid-template-columns:150px 30px 1fr;gap:16px;align-items:start\"><div style=\"font-size:28px;font-weight:800;color:#2e6475;text-align:right;padding-top:6px\">Month 6</div><div style=\"position:relative;height:100%\"><span style=\"position:absolute;left:5px;top:12px;width:20px;height:20px;border-radius:50%;background:#2e6475\"></span><span style=\"position:absolute;left:14px;top:34px;bottom:-26px;width:3px;background:#d9e2e5\"></span></div><div class=\"card\" style=\"padding:14px 18px;font-size:21px;font-family:Lora,serif;line-height:1.4\">Easy classics such as Minuet in G (Petzold). Eighth notes and dotted rhythms. Chord inversions.</div></div><div style=\"display:grid;grid-template-columns:150px 30px 1fr;gap:16px;align-items:start\"><div style=\"font-size:28px;font-weight:800;color:#b86a0a;text-align:right;padding-top:6px\">Year 1</div><div style=\"position:relative;height:100%\"><span style=\"position:absolute;left:5px;top:12px;width:20px;height:20px;border-radius:50%;background:#f6b31e\"></span></div><div class=\"card\" style=\"padding:14px 18px;font-size:21px;font-family:Lora,serif;line-height:1.4\">Early-intermediate pieces. Most major scales. Sight-read simple music, and play pop songs from a chord sheet.</div></div></div><div class=\"foot\"><span>Based on 20 minutes of practice, 5\u20136 days a week</span><b>PIANOERS.COM</b></div></body></html>"], "first-easy-piano-songs-note-names": [620, "<!doctype html><html><head><meta charset=\"utf-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,500;1,500&family=Noto+Music&display=swap\" rel=\"stylesheet\">\n<style>*{box-sizing:border-box;margin:0}\nbody{width:1200px;height:620px;font-family:\"Schibsted Grotesk\",Arial,sans-serif;background:#f3f6f7;color:#15191c;padding:52px 60px 0;position:relative;overflow:hidden}\n.eyebrow{font-size:20px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2e6475}\nh