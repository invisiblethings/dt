e=\"24\" font-weight=\"700\" fill=\"#15191c\">G</text>\n<rect x=\"61.60\" y=\"0\" width=\"52.80\" height=\"93.0\" rx=\"4.0\" fill=\"#1c2226\" stroke=\"#0b0f11\" stroke-width=\"1\"/>\n<rect x=\"149.60\" y=\"0\" width=\"52.80\" height=\"93.0\" rx=\"4.0\" fill=\"#1c2226\" stroke=\"#0b0f11\" stroke-width=\"1\"/>\n<rect x=\"325.60\" y=\"0\" width=\"52.80\" height=\"93.0\" rx=\"4.0\" fill=\"#1c2226\" stroke=\"#0b0f11\" stroke-width=\"1\"/></svg><div style=\"font-size:19px;font-family:Lora,serif;color:#33424a;margin-top:8px;line-height:1.4\">Thumb on middle C, one finger per key. \"\u00b7\" means hold the note a little longer.</div></div></div><div class=\"foot\"><span>Pianoers.com piano basics</span><b>PIANOERS.COM</b></div></body></html>"]}