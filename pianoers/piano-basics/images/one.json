n><span style=\"font-size:19px;color:#56666e\">Traditional</span></div><div style=\"font-size:28px;font-weight:800;letter-spacing:.04em;white-space:nowrap;color:#2e6475;margin-top:10px\">C C G G | A A G | F F E E | D D C</div></div><div class=\"card\" style=\"padding:20px 24px\"><div style=\"display:flex;justify-content:space-between;align-items:baseline\"><span style=\"font-size:28px;font-weight:800\">Mary Had a Little Lamb</span><span style=\"font-size:19px;color:#56666e\">Traditional</span></div><div style=\"font-size:28px;font-weight:800;letter-spacing:.04em;white-space:nowrap;color:#2e6475;margin-top:10px\">E D C D | E E E | D D D | E G G</div></div></div><div class=\"card\" style=\"padding:22px 20px\"><div style=\"font-size:22px;font-weight:800;margin-bottom:26px\">Right hand in C position</div><svg width=\"440\" height=\"160\" viewBox=\"0 -30 440 190\"><text x=\"44\" y=\"-12\" text-anchor=\"middle\" font-size=\"22\" font-weight=\"800\" fill=\"#b86a0a\">1</text><text x=\"132\" y=\"-12\" text-anchor=\"middle\" font-size=\"22\" font-weight=\"800\" fill=\"#b86a0a\">2</text><text x=\"220\" y=\"-12\" text-anchor=\"middle\" font-size=\"22\" font-weight=\"800\" fill=\"#b86a0a\">3</text><text x=\"308\" y=\"-12\" text-anchor=\"middle\" font-size=\"22\" font-weight=\"800\" fill=\"#b86a0a\">4</text><text x=\"396\" y=\"-12\" text-anchor=\"middle\" font-size=\"22\" font-weight=\"800\" fill=\"#b86a0a\">5</text><rect x=\"0.00\" y=\"0\" width=\"88.00\" height=\"150\" rx=\"6.0\" fill=\"#fff3d1\" stroke=\"#9aa9ae\" stroke-width=\"1.5\"/>\n<text x=\"44.00\" y=\"138\" text-anchor=\"middle\" font-size=\"24\" font-weight=\"700\" fill=\"#15191c\">C</text>\n<rect x=\"88.00\" y=\"0\" width=\"88.00\" height=\"150\" rx=\"6.0\" fill=\"#fff3d1\" stroke=\"#9aa9ae\" stroke-width=\"1.5\"/>\n<text x=\"132.00\" y=\"138\" text-anchor=\"middle\" font-size=\"24\" font-weight=\"700\" fill=\"#15191c\">D</text>\n<rect x=\"176.00\" y=\"0\" width=\"88.00\" height=\"150\" rx=\"6.0\" fill=\"#fff3d1\" stroke=\"#9aa9ae\" stroke-width=\"1.5\"/>\n<text x=\"220.00\" y=\"138\" text-anchor=\"middle\" font-size=\"24\" font-weight=\"700\" fill=\"#15191c\">E</text>\n<rect x=\"264.00\" y=\"0\" width=\"88.00\" height=\"150\" rx=\"6.0\" fill=\"#fff3d1\" stroke=\"#9aa9ae\" stroke-width=\"1.5\"/>\n<text x=\"308.00\" y=\"138\" text-anchor=\"middle\" font-size=\"24\" font-weight=\"700\" fill=\"#15191c\">F</text>\n<rect x=\"352.00\" y=\"0\" width=\"88.00\" height=\"150\" rx=\"6.0\" fill=\"#fff3d1\" stroke=\"#9aa9ae\" stroke-width=\"1.5\"/>\n<text x=\"396.00\" y=\"138\" text-anchor=\"middle\" font-size=\"24\" font-weight=\"700\" fill=\"#15191c\">G</text>\n<rect x=\"61.60\" y=\"0\" width=\"52.80\" height=\"93.0\" rx=\"4.0\" fill=\"#1c2226\" stroke=\"#0b0f11\" stroke-width=\"1\"/>\n<rect x=\"149.60\" y=\"0\" width=\"52.80\" height=\"93.0\" rx=\"4.0\" fill=\"#1c2226\" stroke=\"#0b0f11\" stroke-width=\"1\"/>\n<rect x=\"325.60\" y=\"0\" width=\"52.80\" height=\"93.0\" rx=\"4.0\" fill=\"#1c2226\" stroke=\"#0b0f11\" stroke-width=\"1\"/></svg><div style=\"font-size:19px;font-family:Lora,serif;color:#33424a;margin-top:8px;line-height:1.4\">Thumb on middle C, one finger per key. \"\u00b7\" means hold the note a little longer.</div></div></div><div class=\"foot\"><span>Pianoers.com piano basics</span><b>PIANOERS.COM</b></div></body></html>"]}