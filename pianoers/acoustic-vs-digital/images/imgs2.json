{"types-of-pianos-keyboard-digital-hybrid-acoustic": [570, "<!doctype html><html><head><meta charset=\"utf-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,500;1,500&family=Noto+Music&display=swap\" rel=\"stylesheet\">\n<style>*{box-sizing:border-box;margin:0}\nbody{width:1200px;height:570px;font-family:\"Schibsted Grotesk\",Arial,sans-serif;background:#f3f6f7;color:#15191c;padding:52px 60px 0;position:relative;overflow:hidden}\n.eyebrow{font-size:20px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2e6475}\nh1{font-size:48px;line-height:1.05;font-weight:800;letter-spacing:-.01em;margin:8px 0 26px}\n.foot{position:absolute;left:60px;right:60px;bottom:20px;display:flex;justify-content:space-between;font-size:17px;color:#56666e;font-weight:500}\n.foot b{letter-spacing:.12em;color:#2e6475}\n.card{background:#fff;border:1px solid #d9e2e5;border-radius:20px;box-shadow:0 1px 2px rgb(21 25 28/6%),0 8px 24px rgb(21 25 28/6%)}\nsvg text{font-family:\"Schibsted Grotesk\",Arial,sans-serif}\n.mus{font-family:\"Noto Music\",serif}\n</style></head><body><div class=\"eyebrow\">Every option</div><h1>From keyboard to grand: all 7 types</h1><div style=\"display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:10px\"><div class=\"card\" style=\"padding:14px 12px;display:flex;flex-direction:column;gap:6px;border-top:6px solid #2e6475\"><div style=\"font-size:19px;font-weight:800;line-height:1.15\">Keyboard</div><div style=\"font-size:15px;font-family:Lora,serif;line-height:1.4;color:#33424a;flex:1\">61 unweighted keys and many sounds. Fine for a first try, not for technique.</div><div style=\"font-size:20px;font-weight:800;color:#2e6475\">$</div></div><div class=\"card\" style=\"padding:14px 12px;display:flex;flex-direction:column;gap:6px;border-top:6px solid #2e6475\"><div style=\"font-size:19px;font-weight:800;line-height:1.15\">Portable digital</div><div style=\"font-size:15px;font-family:Lora,serif;line-height:1.4;color:#33424a;flex:1\">88 weighted keys, speakers and headphones. The usual beginner choice.</div><div style=\"font-size:20px;font-weight:800;color:#2e6475\">$$</div></div><div class=\"card\" style=\"padding:14px 12px;display:flex;flex-direction:column;gap:6px;border-top:6px solid #2e6475\"><div style=\"font-size:19px;font-weight:800;line-height:1.15\">Console digital</div><div style=\"font-size:15px;font-family:Lora,serif;line-height:1.4;color:#33424a;flex:1\">A furniture cabinet, three pedals, better speakers and keys.</div><div style=\"font-size:20px;font-weight:800;color:#2e6475\">$$\u2013$$$</div></div><div class=\"card\" style=\"padding:14px 12px;display:flex;flex-direction:column;gap:6px;border-top:6px solid #5b4a8a\"><div style=\"font-size:19px;font-weight:800;line-height:1.15\">Hybrid</div><div style=\"font-size:15px;font-family:Lora,serif;line-height:1.4;color:#33424a;flex:1\">A real wooden piano action, with digital sound. No strings.</div><div style=\"font-size:20px;font-weight:800;color:#5b4a8a\">$$$$</div></div><div class=\"card\" style=\"padding:14px 12px;display:flex;flex-direction:column;gap:6px;border-top:6px solid #5b4a8a\"><div style=\"font-size:19px;font-weight:800;line-height:1.15\">Silent acoustic</div><div style=\"font-size:15px;font-family:Lora,serif;line-height:1.4;color:#33424a;flex:1\">A real piano with a mute and a headphone system built in.</div><div style=\"font-size:20px;font-weight:800;color:#5b4a8a\">$$$$</div></div><div class=\"card\" style=\"padding:14px 12px;display:flex;flex-direction:column;gap:6px;border-top:6px solid #b86a0a\"><div style=\"font-size:19px;font-weight:800;line-height:1.15\">Upright</div><div style=\"font-size:15px;font-family:Lora,serif;line-height:1.4;color:#33424a;flex:1\">Strings in a tall frame against the wall.</div><div style=\"font-size:20px;font-weight:800;color:#b86a0a\">$$$\u2013$$$$</div></div><div class=\"card\" style=\"padding:14px 12px;display:flex;flex-direction:column;gap:6px;border-top:6px solid #b86a0a\"><div style=\"font-size:19px;font-weight:800;line-height:1.15\">Grand</div><div style=\"font-size:15px;font-family:Lora,serif;line-height:1.4;color:#33424a;flex:1\">Horizontal strings and the finest action. The concert standard.</div><div style=\"font-size:20px;font-weight:800;color:#b86a0a\">$$$$$</div></div></div>\n<div style=\"margin-top:18px;height:14px;border-radius:99px;background:linear-gradient(90deg,#2e6475,#5b4a8a,#b86a0a)\"></div>\n<div style=\"display:flex;justify-content:space-between;margin-top:8px;font-size:17px;font-weight:800\"><span style=\"color:#2e6475\">\u2190 Digital: lighter, quieter, cheaper to own</span><span style=\"color:#b86a0a\">Acoustic: real strings, real resonance \u2192</span></div><div class=\"foot\"><span>$ = under about $300; $$$$$ = grand-piano money</span><b>PIANOERS.COM</b></div></body></html>"], "acoustic-or-digital-piano-decision-flowchart": [830, "<!doctype html><html><head><meta charset=\"utf-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,500;1,500&family=Noto+Music&display=swap\" rel=\"stylesheet\">\n<style>*{box-sizing:border-box;margin:0}\nbody{width:1200px;height:830px;font-family:\"Schibsted Grotesk\",Arial,sans-serif;background:#f3f6f7;color:#15191c;padding:52px 60px 0;position:relative;overflow:hidden}\n.eyebrow{font-size:20px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2e6475}\nh1{font-size:48px;line-height:1.05;font-weight:800;letter-spacing:-.01em;margin:8px 0 26px}\n.foot{position:absolute;left:60px;right:60px;bottom:20px;display:flex;justify-content:space-between;font-size:17px;color:#56666e;font-weight:500}\n.foot b{letter-spacing:.12em;color:#2e6475}\n.card{background:#fff;border:1px solid #d9e2e5;border-radius:20px;box-shadow:0 1px 2px rgb(21 25 28/6%),0 8px 24px rgb(21 25 28/6%)}\nsvg text{font-family:\"Schibsted Grotesk\",Arial,sans-serif}\n.mus{font-family:\"Noto Music\",serif}\n</style></head><body><div class=\"eyebrow\">Decide in 30 seconds</div><h1>Should you buy an acoustic or digital piano?</h1><div style=\"display:flex;flex-direction:column;gap:6px\"><div style=\"display:grid;grid-template-columns:1fr 60px 1fr;gap:12px;align-items:center\"><div class=\"card\" style=\"padding:14px 18px;background:#15191c;color:#fff;border:0;font-size:20px;font-weight:800\">Will you practise while others sleep, or share walls?</div><div style=\"text-align:center;font-weight:800;color:#1f7a4d;font-size:17px\">YES \u2192</div><div class=\"card\" style=\"padding:12px 16px;border-left:6px solid #2e6475\"><div style=\"font-size:19px;font-weight:800\">Digital piano</div><div style=\"font-size:15.5px;color:#56666e;margin-top:2px\">Or a silent acoustic, if the budget allows.</div></div></div><div style=\"width:140px;text-align:center;font-weight:800;color:#b0442d;font-size:16px;margin:4px 0\">\u2193 NO</div><div style=\"display:grid;grid-template-columns:1fr 60px 1fr;gap:12px;align-items:center\"><div class=\"card\" style=\"padding:14px 18px;background:#15191c;color:#fff;border:0;font-size:20px;font-weight:800\">Is your budget under about $3,000?</div><div style=\"text-align:center;font-weight:800;color:#1f7a4d;font-size:17px\">YES \u2192</div><div class=\"card\" style=\"padding:12px 16px;border-left:6px solid #2e6475\"><div style=\"font-size:19px;font-weight:800\">A good digital piano</div><div style=\"font-size:15.5px;color:#56666e;margin-top:2px\">It beats a cheap acoustic that needs work.</div></div></div><div style=\"width:140px;text-align:center;font-weight:800;color:#b0442d;font-size:16px;margin:4px 0\">\u2193 NO</div><div style=\"display:grid;grid-template-columns:1fr 60px 1fr;gap:12px;align-items:center\"><div class=\"card\" style=\"padding:14px 18px;background:#15191c;color:#fff;border:0;font-size:20px;font-weight:800\">Short on space, or can\u2019t keep the humidity steady?</div><div style=\"text-align:center;font-weight:800;color:#1f7a4d;font-size:17px\">YES \u2192</div><div class=\"card\" style=\"padding:12px 16px;border-left:6px solid #2e6475\"><div style=\"font-size:19px;font-weight:800\">Digital or hybrid</div><div style=\"font-size:15.5px;color:#56666e;margin-top:2px\">Acoustics need steady humidity and room.</div></div></div><div style=\"width:140px;text-align:center;font-weight:800;color:#b0442d;font-size:16px;margin:4px 0\">\u2193 NO</div><div style=\"display:grid;grid-template-columns:1fr 60px 1fr;gap:12px;align-items:center\"><div class=\"card\" style=\"padding:14px 18px;background:#15191c;color:#fff;border:0;font-size:20px;font-weight:800\">Are you serious about classical piano for years?</div><div style=\"text-align:center;font-weight:800;color:#1f7a4d;font-size:17px\">YES \u2192</div><div class=\"card\" style=\"padding:12px 16px;border-left:6px solid #b86a0a\"><div style=\"font-size:19px;font-weight:800\">Acoustic piano</div><div style=\"font-size:15.5px;color:#56666e;margin-top:2px\">Have a technician inspect any used piano first.</div></div></div><div style=\"display:grid;grid-template-columns:1fr 60px 1fr;gap:12px;align-items:center;margin-top:10px\"><div style=\"text-align:right;font-weight:800;color:#b0442d;font-size:16px\">NO \u2192</div><div></div><div class=\"card\" style=\"padding:12px 16px;border-left:6px solid #5b4a8a\"><div style=\"font-size:19px;font-weight:800\">Either works</div><div style=\"font-size:15.5px;color:#56666e;margin-top:2px\">Play both in a store and pick the one you love.</div></div></div></div><div class=\"foot\"><span>Pianoers.com \u00b7 Acoustic vs digital piano</span><b>PIANOERS.COM</b></div></body></html>"], "acoustic-vs-digital-piano-maintenance": [760, "<!doctype html><html><head><meta charset=\"utf-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,500;1,500&family=Noto+Music&display=swap\" rel=\"stylesheet\">\n<style>*{box-sizing:border-box;margin:0}\nbody{width:1200px;height:760px;font-family:\"Schibsted Grotesk\",Arial,sans-serif;background:#f3f6f7;color:#15191c;padding:52px 60px 0;position:relative;overflow:hidden}\n.eyebrow{font-size:20px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2e6475}\nh1{font-size:48px;line-height:1.05;font-weight:800;letter-spacing:-.01em;margin:8px 0 26px}\n.foot{position:absolute;left:60px;right:60px;bottom:20px;display:flex;justify-content:space-between;font-size:17px;color:#56666e;font-weight:500}\n.foot b{letter-spacing:.12em;color:#2e6475}\n.card{background:#fff;border:1px solid #d9e2e5;border-radius:20px;box-shadow:0 1px 2px rgb(21 25 28/6%),0 8px 24px rgb(21 25 28/6%)}\nsvg text{font-family:\"Schibsted Grotesk\",Arial,sans-serif}\n.mus{font-family:\"Noto Music\",serif}\n</style></head><body><div class=\"eyebrow\">Upkeep</div><h1>What each piano needs to stay at its best</h1><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:18px\"><div class=\"card\" style=\"padding:20px 22px\"><div style=\"font-size:15px;font-weight:800;letter-spacing:.1em;color:#b86a0a\">ACOUSTIC PIANO</div><div style=\"font-size:26px;font-weight:800;margin:4px 0 10px\">Regular care</div><div style=\"display:grid;grid-template-columns:130px 1fr;gap:12px;padding:12px 0;border-top:1px solid #d9e2e5\"><b style=\"font-size:18px\">Tuning</b><span style=\"font-size:17px;font-family:Lora,serif;line-height:1.4\">3 to 4 times in the first year, then at least twice a year</span></div><div style=\"display:grid;grid-template-columns:130px 1fr;gap:12px;padding:12px 0;border-top:1px solid #d9e2e5\"><b style=\"font-size:18px\">Humidity</b><span style=\"font-size:17px;font-family:Lora,serif;line-height:1.4\">Keep it steady all year; away from radiators, windows and vents</span></div><div style=\"display:grid;grid-template-columns:130px 1fr;gap:12px;padding:12px 0;border-top:1px solid #d9e2e5\"><b style=\"font-size:18px\">Regulation</b><span style=\"font-size:17px;font-family:Lora,serif;line-height:1.4\">Every few years, or when keys feel uneven</span></div><div style=\"display:grid;grid-template-columns:130px 1fr;gap:12px;padding:12px 0;border-top:1px solid #d9e2e5\"><b style=\"font-size:18px\">Voicing</b><span style=\"font-size:17px;font-family:Lora,serif;line-height:1.4\">When the tone turns harsh or dull</span></div><div style=\"display:grid;grid-template-columns:130px 1fr;gap:12px;padding:12px 0;border-top:1px solid #d9e2e5\"><b style=\"font-size:18px\">Cleaning</b><span style=\"font-size:17px;font-family:Lora,serif;line-height:1.4\">Dust weekly; wipe keys with a barely damp cloth</span></div></div><div class=\"card\" style=\"padding:20px 22px\"><div style=\"font-size:15px;font-weight:800;letter-spacing:.1em;color:#2e6475\">DIGITAL PIANO</div><div style=\"font-size:26px;font-weight:800;margin:4px 0 10px\">Almost nothing</div><div style=\"display:grid;grid-template-columns:130px 1fr;gap:12px;padding:12px 0;border-top:1px solid #d9e2e5\"><b style=\"font-size:18px\">Tuning</b><span style=\"font-size:17px;font-family:Lora,serif;line-height:1.4\">Never</span></div><div style=\"display:grid;grid-template-columns:130px 1fr;gap:12px;padding:12px 0;border-top:1px solid #d9e2e5\"><b style=\"font-size:18px\">Cleaning</b><span style=\"font-size:17px;font-family:Lora,serif;line-height:1.4\">Use a dust cover; wipe keys with a barely damp cloth</span></div><div style=\"display:grid;grid-template-columns:130px 1fr;gap:12px;padding:12px 0;border-top:1px solid #d9e2e5\"><b style=\"font-size:18px\">Updates</b><span style=\"font-size:17px;font-family:Lora,serif;line-height:1.4\">Install firmware and app updates now and then</span></div><div style=\"display:grid;grid-template-columns:130px 1fr;gap:12px;padding:12px 0;border-top:1px solid #d9e2e5\"><b style=\"font-size:18px\">Checks</b><span style=\"font-size:17px;font-family:Lora,serif;line-height:1.4\">Pedal, power and headphone cables</span></div><div style=\"display:grid;grid-template-columns:130px 1fr;gap:12px;padding:12px 0;border-top:1px solid #d9e2e5\"><b style=\"font-size:18px\">Wear</b><span style=\"font-size:17px;font-family:Lora,serif;line-height:1.4\">Keys can get noisier after years of heavy use</span></div></div></div><div class=\"card\" style=\"margin-top:16px;padding:14px 20px;font-size:17px\">Tuning schedule: Piano Technicians Guild guidance. Expect about $100 to $200 a visit in the US.</div><div class=\"foot\"><span>Pianoers.com \u00b7 Acoustic vs digital piano</span><b>PIANOERS.COM</b></div></body></html>"], "piano-buying-checklist-acoustic-and-digital": [660, "<!doctype html><html><head><meta charset=\"utf-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,500;1,500&family=Noto+Music&display=swap\" rel=\"stylesheet\">\n<style>*{box-sizing:border-box;margin:0}\nbody{width:1200px;height:660px;font-family:\"Schibsted Grotesk\",Arial,sans-serif;background:#f3f6f7;color:#15191c;padding:52px 60px 0;position:relative;overflow:hidden}\n.eyebrow{font-size:20px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2e6475}\nh1{font-size:48px;line-height:1.05;font-weight:800;letter-spacing:-.01em;margin:8px 0 26px}\n.foot{position:absolute;left:60px;right:60px;bottom:20px;display:flex;justify-content:space-between;font-size:17px;color:#56666e;font-weight:500}\n.foot b{letter-spacing:.12em;color:#2e6475}\n.card{background:#fff;border:1px solid #d9e2e5;border-radius:20px;box-shadow:0 1px 2px rgb(21 25 28/6%),0 8px 24px rgb(21 25 28/6%)}\nsvg text{font-family:\"Schibsted Grotesk\",Arial,sans-serif}\n.mus{font-family:\"Noto Music\",serif}\n</style></head><body><div class=\"eyebrow\">Before you buy</div><h1>The piano buying checklist</h1><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:18px\"><div class=\"card\" style=\"padding:20px 22px\"><div style=\"font-size:24px;font-weight:800;margin-bottom:6px;color:#b86a0a\">Buying a used acoustic</div><div style=\"display:flex;gap:12px;align-items:flex-start;padding:9px 0\"><span style=\"flex:none;width:24px;height:24px;border-radius:7px;border:3px solid #b86a0a;margin-top:2px\"></span><span style=\"font-size:18px;line-height:1.4\">Have a piano technician inspect it before you pay</span></div><div style=\"display:flex;gap:12px;align-items:flex-start;padding:9px 0\"><span style=\"flex:none;width:24px;height:24px;border-radius:7px;border:3px solid #b86a0a;margin-top:2px\"></span><span style=\"font-size:18px;line-height:1.4\">Check the pitch: a piano far below pitch needs extra work</span></div><div style=\"display:flex;gap:12px;align-items:flex-start;padding:9px 0\"><span style=\"flex:none;width:24px;height:24px;border-radius:7px;border:3px solid #b86a0a;margin-top:2px\"></span><span style=\"font-size:18px;line-height:1.4\">Look for cracks in the soundboard and loose tuning pins</span></div><div style=\"display:flex;gap:12px;align-items:flex-start;padding:9px 0\"><span style=\"flex:none;width:24px;height:24px;border-radius:7px;border:3px solid #b86a0a;margin-top:2px\"></span><span style=\"font-size:18px;line-height:1.4\">Play every key soft and loud; listen for buzzes and sticking</span></div><div style=\"display:flex;gap:12px;align-items:flex-start;padding:9px 0\"><span style=\"flex:none;width:24px;height:24px;border-radius:7px;border:3px solid #b86a0a;margin-top:2px\"></span><span style=\"font-size:18px;line-height:1.4\">Try all pedals and check the dampers stop the sound</span></div><div style=\"display:flex;gap:12px;align-items:flex-start;padding:9px 0\"><span style=\"flex:none;width:24px;height:24px;border-radius:7px;border:3px solid #b86a0a;margin-top:2px\"></span><span style=\"font-size:18px;line-height:1.4\">Add moving and a first tuning to the price</span></div></div><div class=\"card\" style=\"padding:20px 22px\"><div style=\"font-size:24px;font-weight:800;margin-bottom:6px;color:#2e6475\">Buying a digital piano</div><div style=\"display:flex;gap:12px;align-items:flex-start;padding:9px 0\"><span style=\"flex:none;width:24px;height:24px;border-radius:7px;border:3px solid #2e6475;margin-top:2px\"></span><span style=\"font-size:18px;line-height:1.4\">88 fully weighted, hammer-action keys</span></div><div style=\"display:flex;gap:12px;align-items:flex-start;padding:9px 0\"><span style=\"flex:none;width:24px;height:24px;border-radius:7px;border:3px solid #2e6475;margin-top:2px\"></span><span style=\"font-size:18px;line-height:1.4\">Touch sensitivity you can adjust</span></div><div style=\"display:flex;gap:12px;align-items:flex-start;padding:9px 0\"><span style=\"flex:none;width:24px;height:24px;border-radius:7px;border:3px solid #2e6475;margin-top:2px\"></span><span style=\"font-size:18px;line-height:1.4\">At least 64-note polyphony; 128 or more is better</span></div><div style=\"display:flex;gap:12px;align-items:flex-start;padding:9px 0\"><span style=\"flex:none;width:24px;height:24px;border-radius:7px;border:3px solid #2e6475;margin-top:2px\"></span><span style=\"font-size:18px;line-height:1.4\">A real piano-style sustain pedal (half-pedal is a bonus)</span></div><div style=\"display:flex;gap:12px;align-items:flex-start;padding:9px 0\"><span style=\"flex:none;width:24px;height:24px;border-radius:7px;border:3px solid #2e6475;margin-top:2px\"></span><span style=\"font-size:18px;line-height:1.4\">Headphone jack, and USB or Bluetooth MIDI for apps</span></div><div style=\"display:flex;gap:12px;align-items:flex-start;padding:9px 0\"><span style=\"flex:none;width:24px;height:24px;border-radius:7px;border:3px solid #2e6475;margin-top:2px\"></span><span style=\"font-size:18px;line-height:1.4\">Speakers loud enough for your room, and a sturdy stand</span></div></div></div><div class=\"foot\"><span>Pianoers.com \u00b7 Acoustic vs digital piano</span><b>PIANOERS.COM</b></div></body></html>"], "acoustic-vs-digital-piano-featured": [675, "<!doctype html><html><head><meta charset=\"utf-8\"><link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:wght@500&display=