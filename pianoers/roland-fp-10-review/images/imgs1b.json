{"roland-pha-4-standard-action-explained": [800, "<!doctype html><html><head><meta charset=\"utf-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,500;1,500&family=Noto+Music&display=swap\" rel=\"stylesheet\">\n<style>*{box-sizing:border-box;margin:0}\nbody{width:1200px;height:800px;font-family:\"Schibsted Grotesk\",Arial,sans-serif;background:#f3f6f7;color:#15191c;padding:52px 60px 0;position:relative;overflow:hidden}\n.eyebrow{font-size:20px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2e6475}\nh1{font-size:48px;line-height:1.05;font-weight:800;letter-spacing:-.01em;margin:8px 0 26px}\n.foot{position:absolute;left:60px;right:60px;bottom:20px;display:flex;justify-content:space-between;font-size:17px;color:#56666e;font-weight:500}\n.foot b{letter-spacing:.12em;color:#2e6475}\n.card{background:#fff;border:1px solid #d9e2e5;border-radius:20px;box-shadow:0 1px 2px rgb(21 25 28/6%),0 8px 24px rgb(21 25 28/6%)}\nsvg text{font-family:\"Schibsted Grotesk\",Arial,sans-serif}\n.mus{font-family:\"Noto Music\",serif}\n</style></head><body><div class=\"eyebrow\">The keys</div><h1>PHA-4 Standard action, explained</h1><div style=\"display:grid;grid-template-columns:1.1fr 1fr;gap:18px\"><div class=\"card\" style=\"padding:20px 22px\"><div style=\"font-size:15px;font-weight:800;letter-spacing:.1em;color:#2e6475\">INSIDE A KEY (SIMPLIFIED)</div><svg viewBox=\"0 0 520 230\" width=\"100%\"><rect x=\"20\" y=\"150\" width=\"380\" height=\"34\" rx=\"6\" fill=\"#fff\" stroke=\"#15191c\" stroke-width=\"3\"/><rect x=\"20\" y=\"150\" width=\"120\" height=\"34\" rx=\"6\" fill=\"#f3efe6\" stroke=\"#15191c\" stroke-width=\"3\"/><text x=\"80\" y=\"207\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#56666e\">Ivory-feel key top</text><circle cx=\"330\" cy=\"167\" r=\"6\" fill=\"#15191c\"/><path d=\"M400 167 L470 95\" stroke=\"#15191c\" stroke-width=\"6\" stroke-linecap=\"round\"/><circle cx=\"478\" cy=\"86\" r=\"22\" fill=\"#f6b31e\"/><text x=\"420\" y=\"60\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#56666e\">Hammer weight</text><path d=\"M60 90 v40 M45 115 l15 15 l15 -15\" stroke=\"#2e6475\" stroke-width=\"5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"88\" y=\"118\" font-size=\"15\" font-weight=\"700\" fill=\"#2e6475\">You press down here</text><rect x=\"250\" y=\"186\" width=\"40\" height=\"14\" rx=\"3\" fill=\"#2e6475\"/><text x=\"270\" y=\"224\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#2e6475\">Escapement notch</text></svg></div><div class=\"card\" style=\"padding:20px 22px\"><div style=\"font-size:15px;font-weight:800;letter-spacing:.1em;color:#2e6475\">KEY WEIGHT, LOW TO HIGH</div><div style=\"display:flex;gap:6px;align-items:flex-end;height:160px;margin-top:20px\"><div style=\"flex:1;height:150px;background:#15191c;opacity:1.00;border-radius:4px 4px 0 0\"></div><div style=\"flex:1;height:141px;background:#15191c;opacity:0.94;border-radius:4px 4px 0 0\"></div><div style=\"flex:1;height:132px;background:#15191c;opacity:0.88;border-radius:4px 4px 0 0\"></div><div style=\"flex:1;height:123px;background:#15191c;opacity:0.82;border-radius:4px 4px 0 0\"></div><div style=\"flex:1;height:114px;background:#15191c;opacity:0.76;border-radius:4px 4px 0 0\"></div><div style=\"flex:1;height:105px;background:#15191c;opacity:0.70;border-radius:4px 4px 0 0\"></div><div style=\"flex:1;height:96px;background:#15191c;opacity:0.64;border-radius:4px 4px 0 0\"></div><div style=\"flex:1;height:87px;background:#15191c;opacity:0.58;border-radius:4px 4px 0 0\"></div><div style=\"flex:1;height:78px;background:#15191c;opacity:0.52;border-radius:4px 4px 0 0\"></div><div style=\"flex:1;height:69px;background:#15191c;opacity:0.46;border-radius:4px 4px 0 0\"></div></div><div style=\"display:flex;justify-content:space-between;font-size:16px;font-weight:700;color:#56666e;margin-top:8px\"><span>Bass: heavier</span><span>Treble: lighter</span></div></div></div><div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:16px\"><div class=\"card\" style=\"padding:16px 18px;border-top:6px solid #f6b31e\"><div style=\"font-size:21px;font-weight:800\">Graded weight</div><div style=\"font-size:16.5px;font-family:Lora,serif;line-height:1.4;color:#33424a;margin-top:5px\">Heavier in the bass, lighter in the treble, like an acoustic piano.</div></div><div class=\"card\" style=\"padding:16px 18px;border-top:6px solid #2e6475\"><div style=\"font-size:21px;font-weight:800\">Escapement</div><div style=\"font-size:16.5px;font-family:Lora,serif;line-height:1.4;color:#33424a;margin-top:5px\">A tiny notch you feel when you press a key slowly, copying the hammer release of a grand.</div></div><div class=\"card\" style=\"padding:16px 18px;border-top:6px solid #5b4a8a\"><div style=\"font-size:21px;font-weight:800\">Ivory feel</div><div style=\"font-size:16.5px;font-family:Lora,serif;line-height:1.4;color:#33424a;margin-top:5px\">Moisture-absorbing key tops that grip slightly, so fingers slip less.</div></div><div class=\"card\" style=\"padding:16px 18px;border-top:6px solid #b86a0a\"><div style=\"font-size:21px;font-weight:800\">Fast repetition</div><div style=\"font-size:16.5px;font-family:Lora,serif;line-height:1.4;color:#33424a;margin-top:5px\">High-resolution sensing lets you repeat a note quickly and evenly.</div></div></div><div class=\"card\" style=\"margin-top:14px;padding:13px 20px;font-size:17px;background:#fff8e6\">The same PHA-4 Standard action is in Roland's pricier FP-30X. Simplified illustration, not to scale.</div><div class=\"foot\"><span>Pianoers.com \u00b7 Roland FP-10 review</span><b>PIANOERS.COM</b></div></body></html>"], "roland-fp-10-connections": [700, "<!doctype html><html><head><meta charset=\"utf-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,500;1,500&family=Noto+Music&display=swap\" rel=\"stylesheet\">\n<style>*{box-sizing:border-box;margin:0}\nbody{width:1200px;height:700px;font-family:\"Schibsted Grotesk\",Arial,sans-serif;background:#f3f6f7;color:#15191c;padding:52px 60px 0;position:relative;overflow:hidden}\n.eyebrow{font-size:20px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2e6475}\nh1{font-size:48px;line-height:1.05;font-weight:800;letter-spacing:-.01em;margin:8px 0 26px}\n.foot{position:absolute;left:60px;right:60px;bottom:20px;display:flex;justify-content:space-between;font-size:17px;color:#56666e;font-weight:500}\n.foot b{letter-spacing:.12em;color:#2e6475}\n.card{background:#fff;border:1px solid #d9e2e5;border-radius:20px;box-shadow:0 1px 2px rgb(21 25 28/6%),0 8px 24px rgb(21 25 28/6%)}\nsvg text{font-family:\"Schibsted Grotesk\",Arial,sans-serif}\n.mus{font-family:\"Noto Music\",serif}\n</style></head><body><div class=\"eyebrow\">Connections</div><h1>What you can plug into the FP-10</h1><div style=\"display:grid;grid-template-columns:1fr 1.05fr 1fr;gap:16px;align-items:center\"><div style=\"display:flex;flex-direction:column;gap:10px\"><div class=\"card\" style=\"padding:14px 16px;border-left:6px solid #2e6475\"><div style=\"font-size:19px;font-weight:800\">Phone or tablet (Bluetooth MIDI)</div><div style=\"font-size:15.5px;color:#56666e;margin-top:3px;line-height:1.35\">Roland Piano App, GarageBand and learning apps. No cable needed.</div></div><div class=\"card\" style=\"padding:14px 16px;border-left:6px solid #2e6475\"><div style=\"font-size:19px;font-weight:800\">Computer (USB Type B)</div><div style=\"font-size:15.5px;color:#56666e;margin-top:3px;line-height:1.35\">USB MIDI for apps, notation and recording software.</div></div><div class=\"card\" style=\"padding:14px 16px;border-left:6px solid #56666e\"><div style=\"font-size:19px;font-weight:800\">USB Type A port</div><div style=\"font-size:15.5px;color:#56666e;margin-top:3px;line-height:1.35\">For system updates.</div></div></div><div style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px\"><img src=\"file:///home/user/dt/pianoers/roland-fp-10-review/images/clean-angle.png\" style=\"width:100%;border-radius:14px\"><div style=\"font-size:22px;font-weight:800\">Roland FP-10</div></div><div style=\"display:flex;flex-direction:column;gap:10px\"><div class=\"card\" style=\"padding:14px 16px;border-left:6px solid #f6b31e\"><div style=\"font-size:19px;font-weight:800\">Headphones (3.5 mm mini jack)</div><div style=\"font-size:15.5px;color:#56666e;margin-top:3px;line-height:1.35\">Use a 6.3 mm adapter for studio headphones.</div></div><div class=\"card\" style=\"padding:14px 16px;border-left:6px solid #f6b31e\"><div style=\"font-size:19px;font-weight:800\">Same jack as an output</div><div style=\"font-size:15.5px;color:#56666e;margin-top:3px;line-height:1.35\">Connect powered speakers or an amp with a cable.</div></div><div class=\"card\" style=\"padding:14px 16px;border-left:6px solid #f6b31e\"><div style=\"font-size:19px;font-weight:800\">Pedal</div><div style=\"font-size:15.5px;color:#56666e;margin-top:3px;line-height:1.35\">On/off pedal switch included. Optional DP-10 adds half-pedalling.</div></div></div></div><div class=\"card\" style=\"margin-top:16px;padding:14px 20px;font-size:17px;background:#fbe4dd\"><b>Not on the FP-10:</b> Bluetooth audio (playing music from your phone through its speakers), a separate line out, a second headphone jack, or a three-pedal unit.</div><div class=\"foot\"><span>Based on Roland FP-10 specifications</span><b>PIANOERS.COM</b></div></body></html>"]}