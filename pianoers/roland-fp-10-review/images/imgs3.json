sition:absolute;left:63%;top:37.5%;transform:translate(-50%,-50%);width:38px;height:38px;border-radius:50%;background:#f6b31e;color:#1b1400;display:grid;place-items:center;font-weight:800;font-size:20px;box-shadow:0 0 0 4px #fff,0 4px 10px rgb(0 0 0/30%)\">3</div><div style=\"position:absolute;left:20%;top:60%;transform:translate(-50%,-50%);width:38px;height:38px;border-radius:50%;background:#f6b31e;color:#1b1400;display:grid;place-items:center;font-weight:800;font-size:20px;box-shadow:0 0 0 4px #fff,0 4px 10px rgb(0 0 0/30%)\">4</div></div></div><div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:16px\"><div class=\"card\" style=\"padding:14px 16px;display:flex;gap:12px\"><div style=\"flex:none;width:32px;height:32px;border-radius:50%;background:#f6b31e;display:grid;place-items:center;font-weight:800\">1</div><div><div style=\"font-size:18px;font-weight:800\">Power</div><div style=\"font-size:15px;color:#56666e;margin-top:2px;line-height:1.35\">Turns the piano on and off.</div></div></div><div class=\"card\" style=\"padding:14px 16px;display:flex;gap:12px\"><div style=\"flex:none;width:32px;height:32px;border-radius:50%;background:#f6b31e;display:grid;place-items:center;font-weight:800\">2</div><div><div style=\"font-size:18px;font-weight:800\">Volume</div><div style=\"font-size:15px;color:#56666e;margin-top:2px;line-height:1.35\">Two buttons, with a five-light level meter above.</div></div></div><div class=\"card\" style=\"padding:14px 16px;display:flex;gap:12px\"><div style=\"flex:none;width:32px;height:32px;border-radius:50%;background:#f6b31e;display:grid;place-items:center;font-weight:800\">3</div><div><div style=\"font-size:18px;font-weight:800\">Piano / Function</div><div style=\"font-size:15px;color:#56666e;margin-top:2px;line-height:1.35\">Back to the main piano, and the key to settings.</div></div></div><div class=\"card\" style=\"padding:14px 16px;display:flex;gap:12px\"><div style=\"flex:none;width:32px;height:32px;border-r