sition:absolute;left:63%;top:37.5%;transform:translate(-50%,-50%);width:38px;height:38px;border-radius:50%;background:#f6b31e;color:#1b1400;display:grid;place-items:center;font-weight:800;font-size:20px;box-shadow:0 0 0 4px #fff,0 4px 10px rgb(0 0 0/30%)\">3</div><div style=\"position:absolute;left:20%;top:60%;transform:translate(-50%,-50%);width:38px;height:38px;border-radius:50%;background:#f6b31e;color:#1b1400;display:grid;place-items:center;font-weight:800;font-size:20px;box-shadow:0 0 0 4px #fff,0 4px 10px rgb(0 0 0/30%)\">4</div></div></div><div style=\"display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:16px\"><div class=\"card\" style=\"padding:14px 16px;display:flex;gap:12px\"><div style=\"flex:none;width:32px;height:32px;border-radius:50%;background:#f6b31e;display:grid;place-items:center;font-weight:800\">1</div><div><div style=\"font-size:18px;font-weight:800\">Power</div><div style=\"font-size:15px;color:#56666e;margin-top:2px;line-height:1.35\">Turns the piano on and off.</div></div></div><div class=\"card\" style=\"padding:14px 16px;display:flex;gap:12px\"><div style=\"flex:none;width:32px;height:32px;border-radius:50%;background:#f6b31e;display:grid;place-items:center;font-weight:800\">2</div><div><div style=\"font-size:18px;font-weight:800\">Volume</div><div style=\"font-size:15px;color:#56666e;margin-top:2px;line-height:1.35\">Two buttons, with a five-light level meter above.</div></div></div><div class=\"card\" style=\"padding:14px 16px;display:flex;gap:12px\"><div style=\"flex:none;width:32px;height:32px;border-radius:50%;background:#f6b31e;display:grid;place-items:center;font-weight:800\">3</div><div><div style=\"font-size:18px;font-weight:800\">Piano / Function</div><div style=\"font-size:15px;color:#56666e;margin-top:2px;line-height:1.35\">Back to the main piano, and the key to settings.</div></div></div><div class=\"card\" style=\"padding:14px 16px;display:flex;gap:12px\"><div style=\"flex:none;width:32px;height:32px;border-radius:50%;background:#f6b31e;display:grid;place-items:center;font-weight:800\">4</div><div><div style=\"font-size:18px;font-weight:800\">15 tones</div><div style=\"font-size:15px;color:#56666e;margin-top:2px;line-height:1.35\">Names printed above the keys: piano, e-piano, harpsichord, vibraphone, organ, strings, pad, jazz scat.</div></div></div></div><div class=\"foot\"><span>Photo: Roland. Annotations: Pianoers</span><b>PIANOERS.COM</b></div></body></html>"], "roland-fp-10-pedal-switch-vs-dp-10": [740, "<!doctype html><html><head><meta charset=\"utf-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,500;1,500&family=Noto+Music&display=swap\" rel=\"stylesheet\">\n<style>*{box-sizing:border-box;margin:0}\nbody{width:1200px;height:740px;font-family:\"Schibsted Grotesk\",Arial,sans-serif;background:#f3f6f7;color:#15191c;padding:52px 60px 0;position:relative;overflow:hidden}\n.eyebrow{font-size:20px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2e6475}\nh1{font-size:48px;line-height:1.05;font-weight:800;letter-spacing:-.01em;margin:8px 0 26px}\n.foot{position:absolute;left:60px;right:60px;bottom:20px;display:flex;justify-content:space-between;font-size:17px;color:#56666e;font-weight:500}\n.foot b{letter-spacing:.12em;color:#2e6475}\n.card{background:#fff;border:1px solid #d9e2e5;border-radius:20px;box-shadow:0 1px 2px rgb(21 25 28/6%),0 8px 24px rgb(21 25 28/6%)}\nsvg text{font-family:\"Schibsted Grotesk\",Arial,sans-serif}\n.mus{font-family:\"Noto Music\",serif}\n</style></head><body><div class=\"eyebrow\">Pedals</div><h1>The included pedal vs the DP-10</h1><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:18px\"><div class=\"card\" style=\"padding:20px;text-align:center\"><div style=\"height:300px;display:grid;place-items:center;background:#fff\"><img src=\"file:///home/user/dt/pianoers/roland-fp-10-review/images/pedal-1125097-tight.png\" style=\"height:130px;width:auto;max-width:90%\"></div><div style=\"display:inline-block;margin-top:10px;font-size:14px;font-weight:800;letter-spacing:.08em;padding:4px 12px;border-radius:99px;background:#e2eef1;color:#2e6475\">IN THE BOX</div><div style=\"font-size:24px;font-weight:800;margin-top:8px\">Pedal switch</div><div style=\"font-size:17px;font-family:Lora,serif;color:#33424a;margin-top:4px;line-height:1.4\">A small on/off switch. It works, but it slides around and can\u2019t half-pedal.</div></div><div class=\"card\" style=\"padding:20px;text-align:center\"><div style=\"height:300px;display:grid;place-items:center;background:#fff\"><img src=\"file:///home/user/dt/pianoers/roland-fp-10-review/images/pedal-1125096-tight.png\" style=\"height:230px;width:auto;max-width:90%\"></div><div style=\"display:inline-block;margin-top:10px;font-size:14px;font-weight:800;letter-spacing:.08em;padding:4px 12px;border-radius:99px;background:#fff3d1;color:#8a5a00\">UPGRADE</div><div style=\"font-size:24px;font-weight:800;margin-top:8px\">Roland DP-10</div><div style=\"font-size:17px;font-family:Lora,serif;color:#33424a;margin-top:4px;line-height:1.4\">Shaped like a real piano pedal, and supports half-pedalling on the FP-10.</div></div></div><div class=\"foot\"><span>Photos: Roland</span><b>PIANOERS.COM</b></div></body></html>"]}