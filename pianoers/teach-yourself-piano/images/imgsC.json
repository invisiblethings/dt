 y2=\"380\" stroke=\"#d9e2e5\" stroke-dasharray=\"4 6\"/><text x=\"772.5\" y=\"408\" text-anchor=\"middle\" font-size=\"17\" fill=\"#56666e\" font-weight=\"700\">Month 9</text><line x1=\"1010.0\" y1=\"30\" x2=\"1010.0\" y2=\"380\" stroke=\"#d9e2e5\" stroke-dasharray=\"4 6\"/><text x=\"1010.0\" y=\"408\" text-anchor=\"end\" font-size=\"17\" fill=\"#56666e\" font-weight=\"700\">Month 12</text><line x1=\"60\" y1=\"380\" x2=\"1010\" y2=\"380\" stroke=\"#15191c\" stroke-width=\"2\"/><line x1=\"60.0\" y1=\"380.0\" x2=\"1010.0\" y2=\"58.0\" stroke=\"#9fbcc5\" stroke-width=\"3\" stroke-dasharray=\"10 8\"/><text x=\"582.5\" y=\"228.9\" font-size=\"16\" fill=\"#6f8f99\" font-weight=\"700\" transform=\"rotate(-18.7 582.5 228.9)\">What most beginners expect</text><path d=\"M60.0,380.0 L139.2,303.0 L178.8,289.0 L265.8,278.5 L329.2,222.5 L424.2,205.0 L519.2,194.5 L582.5,149.0 L693.3,135.0 L788.3,128.0 L851.7,86.0 L1010.0,58.0\" fill=\"none\" stroke=\"#2e6475\" stroke-width=\"6\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/><rect x=\"139.16666666666669\" y=\"30\" width=\"126.66666666666669\" height=\"350\" fill=\"#f6b31e\" opacity=\".13\"/><text x=\"202.50000000000003\" y=\"54\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"800\" fill=\"#b86a0a\">Plateau 1</text><rect x=\"329.1666666666667\" y=\"30\" width=\"190.00000000000006\" height=\"350\" fill=\"#f6b31e\" opacity=\".13\"/><text x=\"424.16666666666674\" y=\"54\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"800\" fill=\"#b86a0a\">Plateau 2</text><rect x=\"582.5\" y=\"30\" width=\"205.83333333333337\" height=\"350\" fill=\"#f6b31e\" opacity=\".13\"/><text x=\"685.4166666666667\" y=\"54\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"800\" fill=\"#b86a0a\">Plateau 3</text><text x=\"46\" y=\"205.0\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"700\" fill=\"#56666e\" transform=\"rotate(-90 46 205.0)\">Skill</text></svg></div><div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px\"><div class=\"card\" style=\"padding:14px 18px\"><div style=\"font-size:15px;font-weight:800;color:#b86a0a\">PLATEAU 1</div><div style=\"font-size:19px;font-weight:800;margin-top:2px\">Hands together feels impossible.</div><div style=\"font-size:16.5px;font-family:Lora,serif;color:#33424a;margin-top:4px;line-height:1.4\"><b>Fix:</b> Drop to level 1 of the coordination ladder and slow right down.</div></div><div class=\"card\" style=\"padding:14px 18px\"><div style=\"font-size:15px;font-weight:800;color:#b86a0a\">PLATEAU 2</div><div style=\"font-size:19px;font-weight:800;margin-top:2px\">Pieces get longer and messier.</div><div style=\"font-size:16.5px;font-family:Lora,serif;color:#33424a;margin-top:4px;line-height:1.4\"><b>Fix:</b> Chunk the hard bars and use the tempo ladder.</div></div><div class=\"card\" style=\"padding:14px 18px\"><div style=\"font-size:15px;font-weight:800;color:#b86a0a\">PLATEAU 3</div><div style=\"font-size:19px;font-weight:800;margin-top:2px\">Your reading lags behind your playing.</div><div style=\"font-size:16.5px;font-family:Lora,serif;color:#33424a;margin-top:4px;line-height:1.4\"><b>Fix:</b> Sight-read four easy bars every single day.</div></div></div><div class=\"foot\"><span>Illustration of a typical first year, not measured data</span><b>PIANOERS.COM</b></div></body></html>"], "weekly-piano-practice-schedule": [760, "<!doctype html><html><head><meta charset=\"utf-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,500;1,500&family=Noto+Music&display=swap\" rel=\"stylesheet\">\n<style>*{box-sizing:border-box;margin:0}\nbody{width:1200px;height:760px;font-family:\"Schibsted Grotesk\",Arial,sans-serif;background:#f3f6f7;color:#15191c;padding:52px 60px 0;position:relative;overflow:hidden}\n.eyebrow{font-size:20px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2e6475}\nh1{font-size:48px;line-height:1.05;font-weight:800;letter-spac