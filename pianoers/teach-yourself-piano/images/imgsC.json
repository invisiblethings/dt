ms:center;font-size:15px;font-weight:800;color:#fff;text-align:center;padding:0 6px;line-height:1.2\">Scales</div></div></div><div style=\"display:flex;flex-direction:column\"><div style=\"text-align:center;font-size:20px;font-weight:800;margin-bottom:8px\">Fri</div><div style=\"height:400px;display:flex;flex-direction:column;gap:3px\"><div style=\"flex:3;background:#9fbcc5;border-radius:8px 8px 0 0;display:grid;place-items:center;font-size:14px;font-weight:800;color:#15191c\">Warm-up</div><div style=\"flex:5;background:#2e6475;display:grid;place-items:center;font-size:15px;font-weight:800;color:#fff\">Reading</div><div style=\"flex:7;background:#f6b31e;display:grid;place-items:center;font-size:15px;font-weight:800;color:#1b1400\">Your piece</div><div style=\"flex:5;background:#b0442d;border-radius:0 0 8px 8px;display:grid;place-items:center;font-size:15px;font-weight:800;color:#fff;text-align:center;padding:0 6px;line-height:1.2\">A song you love</div></div></div><div style=\"display:flex;flex-direction:column\"><div style=\"text-align:center;font-size:20px;font-weight:800;margin-bottom:8px\">Sat</div><div style=\"height:400px;display:flex;flex-direction:column;gap:3px\"><div style=\"flex:3;background:#9fbcc5;border-radius:8px 8px 0 0;display:grid;place-items:center;font-size:14px;font-weight:800;color:#15191c\">Warm-up</div><div style=\"flex:5;background:#2e6475;display:grid;place-items:center;font-size:15px;font-weight:800;color:#fff\">Reading</div><div style=\"flex:7;background:#f6b31e;display:grid;place-items:center;font-size:15px;font-weight:800;color:#1b1400\">Your piece</div><div style=\"flex:5;background:#15191c;border-radius:0 0 8px 8px;display:grid;place-items:center;font-size:15px;font-weight:800;color:#fff;text-align:center;padding:0 6px;line-height:1.2\">Record and review</div></div></div><div style=\"display:flex;flex-direction:column\"><div style=\"text-align:center;font-size:20px;font-weight:800;margin-bottom:8px\">Sun</div><div style=\"height:400px;display:flex;flex-direction:column;gap:3px\"><div style=\"flex:1;border:3px dashed #d9e2e5;border-radius:8px;display:grid;place-items:center;text-align:center;font-size:16px;font-weight:800;color:#56666e;padding:8px\">Rest, or play just for fun</div></div></div></div></div><div style=\"display:flex;flex-direction:column;gap:14px\"><div class=\"card\" style=\"padding:16px 18px\"><div style=\"font-size:19px;font-weight:800;margin-bottom:6px\">20 minutes a day</div><div style=\"display:flex;justify-content:space-between;padding:7px 0;border-top:1px solid #d9e2e5;font-size:17px\"><b>Warm-up</b><span style=\"color:#56666e\">3 min</span></div><div style=\"display:flex;justify-content:space-between;padding:7px 0;border-top:1px solid #d9e2e5;font-size:17px\"><b>Reading</b><span style=\"color:#56666e\">5 min</span></div><div style=\"display:flex;justify-content:space-between;padding:7px 0;border-top:1px solid #d9e2e5;font-size:17px\"><b>Your piece</b><span style=\"color:#56666e\">7 min</span></div><div style=\"display:flex;justify-content:space-between;padding:7px 0;border-top:1px solid #d9e2e5;font-size:17px\"><b>Daily focus</b><span style=\"color:#56666e\">5 min</span></div></div><div class=\"card\" style=\"padding:16px 18px;background:#fff8e6;font-size:17px;line-height:1.45\">The daily focus changes, so every skill gets practised each week, and nothing gets stale.</div></div></div><div class=\"foot\"><span>Pianoers.com \u00b7 Teach yourself piano</span><b>PIANOERS.COM</b></div></body></html>"], "self-taught-piano-video-check": [650, "<!doctype html><html><head><meta charset=\"utf-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,500;1,500&family=Noto+Music&display=swap\" rel=\"stylesheet\">\n<style>*{box-sizing:border-box;margin:0}\nbody{width:1200px;height:650px;font-family:\"Schibsted Grotesk\",Arial,sans-serif;background:#f3f6f7;color:#15191c;padding:52px 60px 0;position:relative;overflow:hidden}\n.eyebrow{font-size:20px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#2e6475}\nh1{font-size:48px;line-height:1.05;font-weight:800;letter-spacing:-.01em;margin:8px 0 26px}\n.foot{position:absolute;left:60px;right:60px;bottom:20px;display:flex;justify-content:space-between;font-size:17px;color:#56666e;font-weight:500}\n.foot b{letter-spacing:.12em;color:#2e6475}\n.card{background:#fff;border:1px solid #d9e2e5;border-radius:20px;box-shadow:0 1px 2px rgb(21 25 28/6%),0 8px 24px rgb(21 25 28/6%)}\nsvg text{font-family:\"Schibsted Grotesk\",Arial,sans-serif}\n.mus{font-family:\"Noto Music\",serif}\n</style></head><body><div class=\"eyebrow\">Be your own teacher</div><h1>The monthly video check</h1><div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:14px\"><div class=\"card\" style=\"padding:18px 20px;display:flex;gap:18px\"><div style=\"width:96px;height:150px;border-radius:18px;background:#15191c;padding:9px;flex:none\"><div style=\"width:100%;height:100%;border-radius:11px;background:linear-gradient(160deg,#2e6475,#9fbcc5);display:grid;place-items:center;color:#fff;font-weight:800;font-size:15px;text-align:center;line-height:1.2\">SIDE</div></div><div><div style=\"font-size:22px;font-weight:800\">From the side</div><div style=\"font-size:16px;color:#56666e;margin:3px 0 8px\">At keyboard height, level with your wrists.</div><div style=\"display:flex;gap:9px;align-items:center;font-size:17.5px;margin-top:6px\"><span style=\"flex:none;width:20px;height:20px;border-radius:6px;border:2.5px solid #2e6475\"></span>Wrists level, not sagging</div><div style=\"display:flex;gap:9px;align-items:center;font-size:17.5px;margin-top:6px\"><span style=\"flex:none;width:20px;height:20px;border-radius:6px;border:2.5px solid #2e6475\"></span>Fingers curved, knuckles firm</div><div style=\"display:flex;gap:9px;align-items:center;font-size:17.5px;margin-top:6px\"><span style=\"flex:none;width:20px;height:20px;border-radius:6px;border:2.5px solid #2e6475\"></span>No tension in the thumb</div></div></div><div class=\"card\" style=\"padding:18px 20px;display:flex;gap:18px\"><div style=\"width:96px;height:150px;border-radius:18px;background:#15191c;padding:9px;flex:none\"><div style=\"width:100%;height:100%;border-radius:11px;background:linear-gradient(160deg,#2e6475,#9fbcc5);display:grid;place-items:center;color:#fff;font-weight:800;font-size:15px;text-align:center;line-height:1.2\">ABOVE</div></div><div><div style=\"font-size:22px;font-weight:800\">From above</div><div style=\"font-size:16px;color:#56666e;margin:3px 0 8px\">Over your hands, looking straight down.</div><div style=\"display:flex;gap:9px;align-items:center;font-size:17.5px;margin-top:6px\"><span style=\"flex:none;width:20px;height:20px;border-radius:6px;border:2.5px solid #2e6475\"></span>Fingers match the numbers</div><div style=\"display:flex;gap:9px;align-items:center;font-size:17.5px;margin-top:6px\"><span style=\"flex:none;width:20px;height:20px;border-radius:6px;border:2.5px solid #2e6475\"></span>The thumb passes under smoothly</div><div style=\"display:flex;gap:9px;align-items:center;font-size:17.5px;margin-top:6px\"><span style=\"flex:none;width:20px;height:20px;border-radius:6px;border:2.5px solid #2e6475\"></span>Hands stay close to the keys</div></div></div><div class=\"card\" style=\"padding:18px 20px;display:flex;gap:18px\"><div style=\"width:96px;height:150px;border-radius:18px;background:#15191c;padding:9px;flex:none\"><div style=\"width:100%;height:100%;border-radius:11px;background:linear-gradient(160deg,#2e6475,#9fbcc5);display:grid;place-items:center;color:#fff;font-weight:800;font-size:15px;text-align:center;line-height:1.2\">WIDE</div></div><div><div style=\"font-size:22px;font-weight:800\">From behind, wide</div><div style=\"font-size:16px;color:#56666e;margin:3px 0 8px\">Your whole body and the bench in shot.</div><div style=\"display:flex;gap:9px;align-items:center;font-size:17.5px;margin-top:6px\"><span style=\"flex:none;width:20px;height:20px;border-radius:6px;border:2.5px solid #2e6475\"></span>Shoulders down and loose</div><div style=\"display:flex;gap:9px;align-items:center;font-size:17.5px;margin-top:6px\"><span style=\"flex:none;width:20px;height:20px;border-radius:6px;border:2.5px solid #2e6475\"></span>Elbows slightly in front of you</div><div style=\"display:flex;gap:9px;align-items:center;font-size:17.5px;margin-top:6px\"><span style=\"flex:none;width:20px;height:20px;border-radius:6px;border:2.5px solid #2e6475\"></span>Feet flat, back tall</div></div></div></div><div class=\"card\" style=\"margin-top:16px;padding:18px 22px;display:grid;grid-template-columns:auto 1fr;gap:22px;align-items:center\"><div style=\"font-size:22px;font-weight:800\">Then listen back for</div><div style=\"display:flex;gap:12px;flex-wrap:wrap\"><span style=\"background:#e2eef1;color:#2e6475;font-weight:800;font-size:17px;padding:8px 14px;border-radius:99px\">A steady beat</span><span style=\"background:#e2eef1;color:#2e6475;font-weight:800;font-size:17px;padding:8px 14px;border-radius:99px\">Even volume</span><span style=\"background:#e2eef1;color:#2e6475;font-weight:800;font-size:17px;padding:8px 14px;border-radius:99px\">Clean pedal changes</span><span style=\"background:#e2eef1;color:#2e6475;font-weight:800;font-size:17px;padding:8px 14px;border-radius:99px\">No pauses at the hard bars</span></div></div><div style=\"margin-top:14px;font-size:17px;color:#56666e\">Film once a month, keep the clips, and compare them. You will hear progress you can't feel day to day.</div><div class=\"foot\"><span>Pianoers.com \u00b7 Teach yourself piano</span><b>PIANOERS.COM</b></div></body></html>"], "teach-yourself-piano-featured": [675, "<!doctype html><html><head><meta charset=\"utf-8\">\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Lora:ital,wght@0,500;1,500&display=swap\" rel=\"stylesheet\">\n<style>*{box-sizing:border-box;margin:0}body{width:1200px;height:675px;overf