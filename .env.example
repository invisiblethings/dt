# Production origin, no trailing slash. Drives canonical URLs, Open Graph URLs,
# the sitemap and the footer label printed inside generated PDFs.
#
# Only needed if the site moves again — the default in src/lib/site.ts already
# matches the production origin. Set it under Netlify → Site configuration →
# Environment variables, then redeploy.
NEXT_PUBLIC_SITE_URL=https://printablesudoku.org
