---
import '@fontsource/barlow-semi-condensed/latin-700.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import JsonLd from '../components/JsonLd.astro';
import { business } from '../data/business';
import { roofingContractor, website, breadcrumb } from '../data/schema';

interface Props {
  title: string;
  description: string;
  image?: string;
  crumbs?: { name: string; href: string }[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, image = '/og.jpg', crumbs = [], schema = [], noindex = false } = Astro.props;
// On Netlify, only the production deploy on the real domain may be indexed. Deploy previews, branch deploys and the
// *.netlify.app address before launch all get noindex automatically (Netlify sets CONTEXT and URL at build time).
const onNetlify = Boolean(process.env.NETLIFY);
const liveDomain = process.env.CONTEXT === 'production' && (process.env.URL ?? '').includes('bbroofingpros.com');
const hide = noindex || (onNetlify && !liveDomain);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const graph = [
  roofingContractor,
  website,
  { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description, isPartOf: { '@id': website['@id'] }, about: { '@id': roofingContractor['@id'] } },
  ...(crumbs.length ? [breadcrumb([{ name: 'Home', href: '/' }, ...crumbs])] : []),
  ...schema,
];
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hide && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#10233a" />
    <script is:inline>if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-reveal');</script>
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <JsonLd data={graph} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script>
      // Reveal sections and count up numbers as they scroll into view. Content is fully visible without JS.
      const html = document.documentElement;
      if (html.classList.contains('js-reveal')) {
        const fmt = new Intl.NumberFormat('en-US');
        const countUp = (el: HTMLElement) => {
          const target = Number(el.dataset.count);
          const decimals = (el.dataset.count!.split('.')[1] ?? '').length;
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / 1400);
            const v = target * (1 - Math.pow(1 - t, 3));
            el.textContent = decimals ? v.toFixed(decimals) : fmt.format(Math.round(v));
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            el.classList.add('is-in');
            el.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
            io.unobserve(el);
          }
        }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('[data-reveal], [data-animate]').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('[data-animate]').forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
