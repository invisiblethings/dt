---
import Icon from './Icon.astro';
import { business } from '../data/business';
interface Props { title?: string; text?: string }
const { title = 'Get a straight answer about your roof', text = `Free estimate, written options, no pressure. ${business.responsePromise} ${business.financing}` } = Astro.props;
---
<section class="cta">
  <div class="wrap cta__in">
    <div class="cta__copy">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--dark" href="/free-estimate/">Get my free estimate <Icon name="arrow" /></a>
      <a class="btn btn--ghost" href={business.phoneHref}><Icon name="phone" /> {business.phone}</a>
    </div>
  </div>
</section>
<style>
  .cta { background: var(--orange); color: #fff; padding-block: clamp(48px, 6vw, 72px); background-image: repeating-linear-gradient(90deg, transparent 0 120px, rgba(0,0,0,.05) 120px 124px); }
  .cta__in { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }
  .cta__copy { display: grid; gap: 10px; max-width: 640px; }
  .cta p { font-size: var(--step-1); }
</style>
