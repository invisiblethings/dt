---
import { PROMO, PRODUCTS, promoPrice } from '../data/site';
const p = PRODUCTS.pianoforall;
const text = `${PROMO.percent}% off Pianoforall.`;
const price = `$${promoPrice(p.price)} instead of $${p.price}.`;
---
{PROMO.active && (
  <div class="promo-bar">
    <p><b>{PROMO.name}:</b>{' '}{text}{' '}<span class="promo-price">{price}</span>{' '}<a href={p.checkout} rel="nofollow" data-track="begin_checkout" data-product={p.id} data-track-location="promo_bar">Get the deal</a></p>
  </div>
)}
