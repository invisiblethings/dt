---
// "What's your roof telling you?" — a 3-question check that routes people to the right next step.
// Plain radio buttons inside fieldsets; the answer appears in a live region. Without JavaScript the
// fallback text points to the phone and estimate form.
import Icon from './Icon.astro';
import { business } from '../data/business';
const q = [
  { name: 'symptom', legend: 'What are you noticing?', options: [
    ['leak', 'Water coming in now'], ['stain', 'Stains on a ceiling'], ['shingles', 'Missing or curling shingles'], ['flat', 'Flat roof: ponding or blisters'], ['none', 'Nothing yet, it just looks old'],
  ] },
  { name: 'age', legend: 'How old is the roof?', options: [
    ['young', 'Under 10 years'], ['mid', '10 to 20 years'], ['old', 'Over 20 years'], ['unknown', "Not sure"],
  ] },
  { name: 'type', legend: 'What kind of roof?', options: [
    ['shingle', 'Sloped, shingles'], ['flat', 'Flat or low slope'], ['both', 'Some of each'],
  ] },
];
---
<div class="rc" data-roofcheck>
  <form class="rc__form" novalidate>
    {q.map((g, i) => (
      <fieldset class="rc__q">
        <legend><span class="rc__n">{i + 1}</span>{g.legend}</legend>
        <div class="rc__opts">
          {g.options.map(([v, l]) => (
            <label class="rc__opt"><input type="radio" name={g.name} value={v} /><span>{l}</span></label>
          ))}
        </div>
      </fieldset>
    ))}
  </form>
  <div class="rc__result" aria-live="polite" data-result>
    <p class="rc__idle">Answer the three questions and we'll tell you what most likely needs to happen next. Free, no sign-up.</p>
    <noscript><p>Call <a href={business.phoneHref}>{business.phone}</a> and describe what you see. We'll tell you straight.</p></noscript>
  </div>
</div>

<script>
  type Rec = { title: string; body: string; cta: string; href: string; tone: 'urgent' | 'normal' };
  const phone = '(718) 981-7663';
  function recommend(s: string, a: string, t: string): Rec {
    if (s === 'leak') return { tone: 'urgent', title: 'Call now: this is an emergency', body: 'Active water damages ceilings, insulation and wiring fast. Call any time: we stop the water first with a tarp or patch, then price the permanent fix.', cta: `Call ${phone}`, href: 'tel:+17189817663' };
    if (s === 'flat' || t === 'flat') return { tone: 'normal', title: a === 'old' ? 'Likely a flat roof replacement' : 'Likely a flat roof repair or coating', body: a === 'old' ? 'Ponding and blisters on an older flat roof usually mean water is already in the insulation. A new TPO, EPDM or mod-bit system is often the cheaper long-term fix.' : 'Younger flat roofs can often be repaired or coated to add years. We check seams, drains and flashing and show you what we find.', cta: 'See flat roofing', href: '/roofing/flat-roofing/' };
    if (a === 'old' || (s === 'shingles' && a !== 'young')) return { tone: 'normal', title: 'Time to price a roof replacement', body: 'Shingles past 20 years, or curling and missing in several places, are near the end of their life. Repairs will keep chasing leaks. A full replacement takes 1–2 days.', cta: 'See roof replacement', href: '/roofing/roof-replacement/' };
    if (s === 'stain' || s === 'shingles') return { tone: 'normal', title: 'Probably a targeted repair', body: 'A stain or a few damaged shingles on a younger roof is usually flashing, a vent boot or wind damage. A repair now prevents a bigger bill later.', cta: 'See roof repair', href: '/roofing/roof-repair/' };
    return { tone: 'normal', title: 'A free estimate visit will tell you', body: 'No symptoms yet is the best time to look. We check the whole roof and tell you honestly how many years it has left.', cta: 'Book a free estimate', href: '/free-estimate/' };
  }
  document.querySelectorAll<HTMLElement>('[data-roofcheck]').forEach((root) => {
    const form = root.querySelector('form')!;
    const out = root.querySelector<HTMLElement>('[data-result]')!;
    form.addEventListener('change', () => {
      const v = (n: string) => (form.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)?.value ?? '');
      const s = v('symptom'), a = v('age'), t = v('type');
      if (s !== 'leak' && (!s || !a || !t)) {
        out.innerHTML = `<p class="rc__idle">${[!s && 'what you see', !a && 'the roof age', !t && 'the roof type'].filter(Boolean).join(', ').replace(/, ([^,]*)$/, ' and $1')} left to go.</p>`;
        return;
      }
      const r = recommend(s, a, t);
      out.innerHTML = `<div class="rc__card rc__card--${r.tone}"><p class="rc__kicker">Our honest read</p><p class="rc__title">${r.title}</p><p>${r.body}</p><p class="rc__actions"><a class="btn ${r.tone === 'urgent' ? 'btn--primary' : 'btn--dark'}" href="${r.href}">${r.cta}</a> <a class="rc__alt" href="/free-estimate/">or get a free estimate</a></p></div>`;
    });
  });
</script>

<style>
  .rc { display: grid; grid-template-columns: 1.3fr 1fr; gap: 24px; align-items: start; }
  @media (max-width: 900px) { .rc { grid-template-columns: 1fr; } }
  .rc__form { display: grid; gap: 18px; }
  .rc__q { border: 0; margin: 0; padding: 0; display: grid; gap: 10px; }
  .rc__q legend { font-family: var(--font-display); font-weight: 700; font-size: 1.625rem; display: flex; align-items: center; gap: 12px; margin-bottom: 12px; color: #fff; }
  .rc__n { width: 38px; height: 38px; border-radius: 50%; background: var(--orange); color: #fff; display: grid; place-items: center; font-size: 1.0625rem; flex: none; }
  .rc__opts { display: flex; flex-wrap: wrap; gap: 10px; }
  .rc__opt { position: relative; }
  .rc__opt input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .rc__opt span { display: inline-flex; align-items: center; min-height: 54px; padding: 10px 20px; border-radius: 12px; border: 2px solid rgba(255,255,255,.4); background: rgba(255,255,255,.06); color: #fff; font-weight: 600; font-size: 1.125rem; cursor: pointer; transition: background-color .15s, border-color .15s; }
  .rc__opt input:checked + span { background: var(--orange); color: #fff; border-color: var(--orange); }
  .rc__opt input:checked + span::before { content: '✓'; margin-right: 8px; font-weight: 800; }
  .rc__opt input:focus-visible + span { outline: 3px solid var(--sky); outline-offset: 2px; }
  .rc__opt:hover span { border-color: #fff; }
  .rc__result { position: sticky; top: 20px; min-height: 220px; border-radius: 14px; border: 2px dashed rgba(255,255,255,.3); padding: 28px; background: rgba(255,255,255,.04); display: grid; align-content: center; }
  .rc__result :global(.rc__idle) { color: #d5e0ea; font-size: 1.1875rem; }
  .rc__result :global(.rc__card) { display: grid; gap: 12px; }
  @media (prefers-reduced-motion: no-preference) { .rc__result :global(.rc__card) { animation: rcIn .45s cubic-bezier(.2,.8,.2,1); } }
  @keyframes rcIn { from { opacity: 0; translate: 0 14px; } }
  .rc__result :global(.rc__kicker) { font-size: .9375rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #ff8a5c; }
  .rc__result :global(.rc__title) { font-family: var(--font-display); font-size: var(--step-2); font-weight: 700; line-height: 1.1; color: #fff; }
  .rc__result :global(.rc__card--urgent .rc__title) { color: #ffb08f; }
  .rc__result :global(.rc__actions) { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 6px; }
  .rc__result :global(.btn--dark) { background: #fff; color: var(--asphalt); }
  .rc__result :global(.rc__alt) { color: var(--sky); }
</style>
