---
// Reviews styled as B&B lawn signs on stakes: the same signs neighbors see on finished jobs.
import Icon from './Icon.astro';
import { reviews } from '../data/reviews';
import { business } from '../data/business';
interface Props { count?: number }
const { count = 3 } = Astro.props;
const list = reviews.slice(0, count);
---
<div class="signs">
  <ul class="signs__row">
    {list.map((r, i) => (
      <li class="sign" style={`--tilt: ${[-1.6, 1.1, -0.7, 1.4, -1.2, 0.8][i % 6]}deg`}>
        <figure class="sign__board">
          <p class="sign__stars" role="img" aria-label="5 out of 5 stars">{[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}</p>
          <blockquote>“{r.text}”</blockquote>
          <figcaption>{r.name} <span>· Google review · {r.job}</span></figcaption>
        </figure>
        <span class="sign__stakes" aria-hidden="true"></span>
      </li>
    ))}
  </ul>
  <p class="signs__more">
    <strong>{business.stats.rating} stars from {business.stats.reviews} Google reviews.</strong>
    <a href={business.social.googleReviews}>Read them all on Google</a>
  </p>
</div>

<style>
  .signs { display: grid; gap: 24px; }
  .signs__row { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 28px 24px; align-items: end; }
  .sign { display: grid; justify-items: center; transform: rotate(var(--tilt)); transform-origin: bottom center; }
  @media (prefers-reduced-motion: no-preference) { .sign { transition: transform .25s; } .sign:hover { transform: rotate(0deg) translateY(-4px); } }
  .sign__board { margin: 0; width: 100%; background: #fff; color: var(--ink); border-radius: 8px; padding: 22px 22px 18px; display: grid; gap: 10px;
    border: 4px solid var(--asphalt); box-shadow: 0 10px 0 -4px var(--orange), var(--shadow); position: relative; }
  .sign__board::before { content: 'B&B ROOFING'; position: absolute; top: -13px; left: 18px; background: var(--orange); color: #fff; font-family: var(--font-display); font-weight: 700; font-size: .8125rem; letter-spacing: .12em; padding: 2px 10px; border-radius: 4px; }
  .sign__stars { display: flex; gap: 2px; color: var(--gold); }
  .sign__stars :global(svg) { width: 20px; height: 20px; }
  .sign blockquote { margin: 0; font-size: 1.0625rem; line-height: 1.5; }
  .sign figcaption { font-weight: 700; }
  .sign figcaption span { font-weight: 400; color: var(--muted); }
  .sign__stakes { width: 60%; height: 38px; background: linear-gradient(90deg, transparent 18%, #7b8691 18% 22%, transparent 22% 78%, #7b8691 78% 82%, transparent 82%); }
  .signs__more { display: flex; flex-wrap: wrap; gap: 8px 16px; justify-content: center; text-align: center; }
</style>
