---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  label: string; // what the photos show, e.g. "Roof replacement in Great Kills"
  eager?: boolean;
  sizes?: string;
  peek?: boolean; // sweep the handle once when first seen, to show it can be dragged
}
const { before, after, label, eager = false, sizes = '(max-width: 760px) 100vw, 600px', peek = false } = Astro.props;
const id = `ba-${Math.random().toString(36).slice(2, 8)}`;
---
<figure class="ba" data-ba data-peek={peek ? '' : undefined} style="--pos: 50%">
  <div class="ba__frame">
    <Image quality={72} class="ba__img" src={after} alt={`After: ${label}`} widths={[640, 1200]} sizes={sizes}
      loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
    <div class="ba__before">
      <Image quality={72} class="ba__img" src={before} alt={`Before: ${label}`} widths={[640, 1200]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
    </div>
    <span class="ba__tag ba__tag--b" aria-hidden="true">Before</span>
    <span class="ba__tag ba__tag--a" aria-hidden="true">After</span>
    <span class="ba__handle" aria-hidden="true"><span><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6 3 12l6 6M15 6l6 6-6 6"/></svg></span></span>
    <label class="visually-hidden" for={id}>Compare before and after: {label}</label>
    <input class="ba__range" id={id} type="range" min="0" max="100" value="50" step="1" />
  </div>
</figure>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('.ba__range');
    if (!range) return;
    let touched = false;
    const set = () => el.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', () => { touched = true; set(); });
    set();
    if (!('peek' in el.dataset) || reduce || !('IntersectionObserver' in window)) return;
    // One gentle sweep (50 → 25 → 75 → 50) so first-time visitors see the photos can be compared.
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const keys = [50, 22, 78, 50];
      const t0 = performance.now() + 900;
      const step = (now: number) => {
        if (touched) return;
        const t = Math.max(0, (now - t0) / 2400);
        if (t >= 1) { range.value = '50'; set(); return; }
        const seg = Math.min(2, Math.floor(t * 3));
        const k = t * 3 - seg;
        const ease = k < .5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
        el.style.setProperty('--pos', `${keys[seg] + (keys[seg + 1] - keys[seg]) * ease}%`);
        requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }, { threshold: .6 });
    io.observe(el);
  });
</script>

<style>
  .ba { margin: 0; }
  .ba__frame { position: relative; overflow: hidden; border-radius: var(--radius); aspect-ratio: 4 / 3; background: var(--slate); box-shadow: var(--shadow); }
  .ba__frame :global(.ba__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ba__before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba__tag { position: absolute; top: 12px; padding: 6px 14px; border-radius: 999px; font-weight: 700; font-size: 0.9375rem; letter-spacing: .08em; text-transform: uppercase; background: rgba(20,24,28,.78); color: #fff; }
  .ba__tag--b { left: 12px; }
  .ba__tag--a { right: 12px; background: var(--orange); }
  .ba__handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 4px; margin-left: -2px; background: #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.15); pointer-events: none; }
  .ba__handle span { position: absolute; top: 50%; left: 50%; translate: -50% -50%; width: 56px; height: 56px; border-radius: 50%; background: var(--orange); color: #fff; display: grid; place-items: center; border: 3px solid #fff; box-shadow: 0 6px 18px rgba(0,0,0,.35); }
  .ba__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; -webkit-appearance: none; appearance: none; }
  .ba__range:focus-visible + * , .ba__frame:has(.ba__range:focus-visible) { outline: 3px solid var(--sky); outline-offset: 3px; }
</style>
