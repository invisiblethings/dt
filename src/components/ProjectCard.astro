---
// Project teaser: before and after side by side, labelled, so the change is obvious without hovering or dragging.
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
interface Props { p: Project }
const { p } = Astro.props;
---
<article class="pc" data-region={p.region} data-kind={p.kind}>
  <a href={p.href} class="pc__link">
    <div class="pc__media">
      <figure><Image quality={72} src={p.before} alt={`Before: ${p.title}`} widths={[320, 560]} sizes="(max-width: 620px) 50vw, 200px" loading="lazy" /><figcaption>Before</figcaption></figure>
      <figure><Image quality={72} src={p.after} alt={`After: ${p.title}`} widths={[320, 560]} sizes="(max-width: 620px) 50vw, 200px" loading="lazy" /><figcaption class="pc__after">After</figcaption></figure>
    </div>
    <div class="pc__body">
      <p class="pc__meta">{p.region} · {p.monthYear}</p>
      <h3>{p.title}</h3>
      <span class="pc__more">See this project <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
    </div>
  </a>
</article>

<style>
  .pc { border-radius: var(--radius); overflow: hidden; background: var(--paper); border: 1px solid var(--line); min-width: 0; box-shadow: var(--shadow-sm); transition: transform .2s, box-shadow .2s; }
  @media (hover: hover) { .pc:hover { transform: translateY(-4px); box-shadow: var(--shadow); } }
  .pc__link { display: grid; grid-template-rows: auto 1fr; color: inherit; text-decoration: none; height: 100%; }
  .pc__media { display: grid; grid-template-columns: 1fr 1fr; gap: 3px; background: #fff; }
  .pc__media figure { margin: 0; position: relative; aspect-ratio: 1 / 1; overflow: hidden; background: var(--slate); }
  .pc__media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: scale .5s; }
  @media (hover: hover) { .pc__link:hover :global(img) { scale: 1.05; } }
  .pc__media figcaption { position: absolute; left: 8px; bottom: 8px; font-size: .875rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; background: rgba(16,35,58,.85); color: #fff; padding: 4px 10px; border-radius: 999px; }
  .pc__media .pc__after { background: var(--orange); }
  .pc__body { padding: 18px 20px 22px; display: grid; gap: 6px; align-content: start; }
  .pc__meta { font-size: .9375rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--orange-dark); }
  .pc h3 { font-size: 1.5rem; color: var(--asphalt); }
  .pc__more { display: inline-flex; align-items: center; gap: 8px; color: var(--navy); font-weight: 700; margin-top: 4px; }
  .pc__more svg { transition: translate .2s; }
  @media (hover: hover) { .pc__link:hover .pc__more svg { translate: 4px 0; } }
</style>
