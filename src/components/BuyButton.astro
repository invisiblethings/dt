---
import { PRODUCTS, PROMO } from '../data/site';
import Price from './Price.astro';
interface Props { product: keyof typeof PRODUCTS; label?: string; location: string; variant?: 'btn' | 'btn btn-dark' | 'btn btn-ghost'; size?: '' | 'btn-lg'; block?: boolean }
const { product, label, location, variant = 'btn btn-dark', size = '', block = false } = Astro.props;
const p = PRODUCTS[product];
const text = label ?? `Buy ${p.name} · $${p.price}`;
const [before, after] = PROMO.active && p.id === 'pianoforall' && text.includes(`$${p.price}`) ? text.split(`$${p.price}`) : [text, null];
---
<a class:list={[variant, size, { 'btn-block': block }]} href={p.checkout} rel="nofollow" data-track="begin_checkout" data-product={p.id} data-track-location={location}>{before}{after !== null && <><Price />{after}</>}</a>
