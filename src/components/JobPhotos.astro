---
// Real job photos with captions. `steps` numbers them when the photos show a sequence (order is information).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Item { src: ImageMetadata; alt: string; caption: string }
interface Props { items: Item[]; steps?: boolean; cols?: 2 | 3 | 4 }
const { items, steps = false, cols = 3 } = Astro.props;
---
<ol class:list={['jp', `jp--${cols}`, { 'jp--steps': steps }]}>
  {items.map((it, i) => (
    <li data-reveal style={`--d: ${(i % cols) * 0.08}s`}>
      <figure>
        <div class="jp__img">
          <Image src={it.src} alt={it.alt} widths={[400, 700, 1000]} sizes={`(max-width: 620px) 100vw, (max-width: 960px) 50vw, ${Math.round(1200 / cols)}px`} quality={72} loading="lazy" />
          {steps && <span class="jp__n" aria-hidden="true">{i + 1}</span>}
        </div>
        <figcaption>{it.caption}</figcaption>
      </figure>
    </li>
  ))}
</ol>
<style>
  .jp { list-style: none; display: grid; gap: 20px; }
  .jp--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .jp--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .jp--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 960px) { .jp--3, .jp--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .jp { grid-template-columns: 1fr !important; } }
  .jp figure { margin: 0; display: grid; gap: 10px; }
  .jp__img { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); background: var(--cloud); box-shadow: var(--shadow-sm); }
  .jp__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: scale .5s; }
  @media (hover: hover) { .jp li:hover .jp__img :global(img) { scale: 1.04; } }
  .jp__n { position: absolute; left: 12px; top: 12px; width: 40px; height: 40px; border-radius: 50%; background: var(--orange); color: #fff; display: grid; place-items: center; font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; border: 3px solid #fff; box-shadow: var(--shadow-sm); }
  .jp figcaption { font-size: 1.0625rem; color: #2f3e4d; line-height: 1.45; }
</style>
