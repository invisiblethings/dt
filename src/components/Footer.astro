---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { services } from '../data/services.js';
import { neighborhoods } from '../data/neighborhoods.js';
import { site } from '../data/site.js';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo layout="stacked" variant="reverse" tagline markSize="52px" class="footer-logo" />
      <p class="footer-desc">{site.licenseNote}. Serving every neighborhood in Brooklyn since {site.founderYear}.</p>
      <div class="footer-social">
        <a href={site.social.facebook} aria-label="Facebook" target="_blank" rel="noopener noreferrer">Facebook</a>
        <a href={site.social.instagram} aria-label="Instagram" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href={site.social.google} aria-label="Google Business Profile" target="_blank" rel="noopener noreferrer">Google</a>
      </div>
    </div>

    <div class="footer-col">
      <h3>Services</h3>
      <ul>
        {services.map((s) => (
          <li><a href={`/services/${s.slug}/`}>{s.navLabel}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <h3>Service Areas</h3>
      <ul>
        {neighborhoods.map((n) => (
          <li><a href={`/service-areas/${n.slug}/`}>{n.name}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <h3>Contact</h3>
      <ul class="footer-contact">
        <li><a href={site.phoneHref}><Icon name="phone" size={16} color="#F05A28" /> {site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}><Icon name="document" size={16} color="#F05A28" /> {site.email}</a></li>
        <li><Icon name="pin" size={16} color="#F05A28" /> Serving all of Brooklyn, NY</li>
        <li><Icon name="clock" size={16} color="#F05A28" /> Mon–Fri 7am–7pm, Sat 8am–5pm<br/>24/7 emergency line</li>
      </ul>
      <a href="/contact/" class="btn btn-ghost-light footer-cta">Request a Free Inspection</a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {year} {site.legalName}. All rights reserved.</p>
      <div class="footer-legal">
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms/">Terms of Service</a>
        <a href="/sitemap-index.xml">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy);
    color: rgba(255,255,255,0.85);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    padding-block: 56px 32px;
  }
  .footer-desc {
    font-size: 0.88rem;
    color: rgba(255,255,255,0.65);
    max-width: 32ch;
    margin-top: 16px;
  }
  .footer-brand :global(.footer-logo) { align-items: flex-start; text-align: left; }
  .footer-brand :global(.logo-tagline) { text-align: left; }
  .footer-social {
    display: flex;
    gap: 16px;
    margin-top: 20px;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .footer-social a { color: rgba(255,255,255,0.7); }
  .footer-social a:hover { color: var(--color-orange); }

  .footer-col h3 {
    color: #fff;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 18px;
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 0.9rem;
  }
  .footer-col a { color: rgba(255,255,255,0.75); }
  .footer-col a:hover { color: var(--color-orange); }
  .footer-contact li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .footer-contact a { display: inline-flex; align-items: center; gap: 8px; }
  .footer-cta { margin-top: 22px; }

  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.12);
  }
  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-block: 20px;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.55);
  }
  .footer-legal { display: flex; gap: 18px; }
  .footer-legal a { color: rgba(255,255,255,0.55); }
  .footer-legal a:hover { color: #fff; }

  @media (min-width: 720px) {
    .footer-grid { grid-template-columns: 1.4fr 1fr 1fr 1.2fr; }
  }
  @media (min-width: 640px) {
    .footer-bottom-inner { flex-direction: row; justify-content: space-between; align-items: center; }
  }
</style>
