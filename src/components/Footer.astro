---
import { BRAND, LINKS, GUARANTEE_DAYS, FEATURES } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/" style="color:#fff;margin-bottom:1rem">
          <img src="/brand/icon-68.png" alt="" width="34" height="34" loading="lazy" />
          <span>Pianoforall</span>
        </a>
        <p>Piano lessons for adults, created by Robin Hall in 2006. Start with chords and rhythm, play by ear, and learn to read as you go.</p>
        <p><a href={`mailto:${BRAND.email}`}>{BRAND.email}</a><br />Robin reads every message.</p>
      </div>
      <nav aria-labelledby="f-courses">
        <h2 id="f-courses">Courses</h2>
        <ul>
          <li><a href="/course">Pianoforall</a></li>
          <li><a href="/classics-by-ear">Classics By Ear</a></li>
          <li><a href="/classics-by-ear/moonlight-sonata">Moonlight Sonata</a></li>
          <li><a href="/classics-by-ear/erik-satie-gnossiennes">Satie Gnossiennes</a></li>
          <li><a href="/classics-by-ear/bach-preludes">Bach Preludes</a></li>
          <li><a href="/pricing">Pricing &amp; bundles</a></li>
          {FEATURES.freeLessons && <li><a href="/free-lessons">Free lessons</a></li>}
        </ul>
      </nav>
      <nav aria-labelledby="f-learn">
        <h2 id="f-learn">Learn</h2>
        <ul>
          <li><a href="/learn">All guides</a></li>
          <li><a href="/learn/learn-piano-online">Learn piano online</a></li>
          <li><a href="/am-i-too-old-to-learn-piano">Learning as an adult</a></li>
          <li><a href="/learn/play-piano-by-ear">Play by ear</a></li>
          <li><a href="/learn/piano-chords-for-beginners">Chords for beginners</a></li>
          <li><a href="/learn/choosing-a-keyboard">Choosing a keyboard</a></li>
          <li><a href="/blog">Blog</a></li>
        </ul>
      </nav>
      <nav aria-labelledby="f-about">
        <h2 id="f-about">Pianoforall</h2>
        <ul>
          <li><a href="/how-it-works">How it works</a></li>
          <li><a href="/about">About Robin Hall</a></li>
          <li><a href="/reviews">Student reviews</a></li>
          <li><a href="/compare">Compare with apps</a></li>
          <li><a href="/start">Where should I start?</a></li>
          <li><a href="/faq">FAQ</a></li>
        </ul>
      </nav>
      <nav aria-labelledby="f-help">
        <h2 id="f-help">Help</h2>
        <ul>
          <li><a href="/contact">Contact &amp; support</a></li>
          <li><a href={LINKS.signIn} rel="nofollow">Student sign in</a></li>
          <li><a href="/refund-policy">{GUARANTEE_DAYS}-day refund policy</a></li>
          <li><a href="/gift">Give a course</a></li>
          <li><a href="/affiliate-program">Affiliate program</a></li>
          <li><a href="/privacy-policy">Privacy</a></li>
          <li><a href="/terms-of-use">Terms</a></li>
        </ul>
      </nav>
    </div>
    <div class="footer-legal">
      <p>© 2006–{year} Pianoforall Academy Limited and Robin Hall. ClickBank is the retailer of products on this site. CLICKBANK® is a registered trademark of Click Sales, Inc., a Delaware corporation located at 1444 S. Entertainment Ave., Suite 410, Boise, ID 83709, USA, and is used by permission. ClickBank's role as retailer does not constitute an endorsement, approval or review of these products or any claim, statement or opinion used in promotion of these products. Your card statement will show a charge from CLKBANK*. Order support: <a href={LINKS.clickbankSupport} rel="nofollow">ClickBank</a> or {LINKS.clickbankPhone}.</p>
    </div>
  </div>
</footer>
