---
interface Props { post: { id: string; data: { title: string; description: string; heroImage?: string; heroAlt?: string; categoryName: string } } }
const { post } = Astro.props;
---
<a class="card card-media card-link" href={`/${post.id}`}>
  {post.data.heroImage ? <img src={post.data.heroImage} alt="" loading="lazy" width="640" height="400" /> : <div style="aspect-ratio:16/10;background:var(--sand)"></div>}
  <div class="card-body">
    <span class="pill" style="align-self:flex-start;margin-bottom:.6rem">{post.data.categoryName}</span>
    <h3>{post.data.title}</h3>
    <p class="muted small">{post.data.description}</p>
  </div>
</a>
