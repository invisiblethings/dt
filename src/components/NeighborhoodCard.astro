---
import Icon from './Icon.astro';

interface Props {
  neighborhood: { slug: string; name: string; landmarks: string[] };
}
const { neighborhood } = Astro.props;
---
<a href={`/service-areas/${neighborhood.slug}/`} class="nbhd-card">
  <span class="nbhd-card-icon"><Icon name="pin" size={20} color="#F05A28" /></span>
  <div>
    <h3>{neighborhood.name}</h3>
    <p>{neighborhood.landmarks.slice(0, 2).join(' · ')}</p>
  </div>
</a>

<style>
  .nbhd-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 18px 20px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .nbhd-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .nbhd-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-orange-100);
    flex-shrink: 0;
  }
  .nbhd-card h3 { font-size: 1rem; margin-bottom: 0.2em; }
  .nbhd-card p { font-size: 0.82rem; color: var(--text-muted); margin: 0; }
</style>
