---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs wrap" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((it, i) => (
      <li>{i === items.length - 1 ? <span aria-current="page">{it.name}</span> : <a href={it.href}>{it.name}</a>}</li>
    ))}
  </ol>
</nav>
