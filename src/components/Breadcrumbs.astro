---
interface Crumb { name: string; path: string; }
interface Props { items: Crumb[]; }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>
        {i === items.length - 1 ? (
          <span aria-current="page">{item.name}</span>
        ) : (
          <>
            <a href={item.path}>{item.name}</a>
            <span class="sep" aria-hidden="true">/</span>
          </>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs { padding-block: 14px; }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .breadcrumbs li { display: flex; align-items: center; gap: 6px; }
  .breadcrumbs a { color: var(--text-muted); font-weight: 600; }
  .breadcrumbs a:hover { color: var(--accent); }
  .breadcrumbs [aria-current='page'] { color: var(--text); font-weight: 600; }
  .sep { opacity: 0.5; }
</style>
