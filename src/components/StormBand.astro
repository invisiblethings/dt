---
// Emergency band: rain falling on a roof in SVG, with the one action that matters when water is coming in.
import Icon from './Icon.astro';
import { business } from '../data/business';
const drops = Array.from({ length: 26 }, (_, i) => ({ x: 12 + ((i * 37) % 300), d: ((i * 53) % 100) / 100, s: 0.9 + ((i * 29) % 50) / 100 }));
---
<section class="storm" aria-labelledby="storm-h">
  <div class="wrap storm__in">
    <svg class="storm__art" viewBox="0 0 320 220" aria-hidden="true" focusable="false">
      <g class="storm__cloud"><circle cx="110" cy="44" r="30" /><circle cx="156" cy="32" r="40" /><circle cx="204" cy="46" r="28" /><rect x="84" y="44" width="146" height="30" rx="15" /></g>
      <g class="storm__rain">{drops.map((r) => <line x1={r.x} y1="70" x2={r.x - 6} y2="86" style={`--d: ${r.d}s; --s: ${r.s}s`} />)}</g>
      <path class="storm__roof" d="M40 150 160 92l120 58" />
      <path class="storm__house" d="M64 140v74h192v-74" />
      <rect class="storm__win" x="96" y="160" width="40" height="30" rx="3" />
      <rect class="storm__door" x="180" y="166" width="34" height="48" rx="3" />
      <path class="storm__drip" d="M160 118s9 10 9 17a9 9 0 0 1-18 0c0-7 9-17 9-17z" />
    </svg>
    <div class="storm__copy">
      <p class="eyebrow">24/7 emergency roof repair</p>
      <h2 id="storm-h">Water coming in right now?</h2>
      <p class="lead">Call us, day or night. We'll talk you through what to do right away and get a crew out to stop the leak and tarp the roof.</p>
      <div class="btn-row">
        <a class="btn btn--primary btn--big" href={business.phoneHref}><Icon name="phone" /> Call {business.phone}</a>
      </div>
      <p class="storm__fine">Real emergencies only after hours: active leaks, storm and tree damage.</p>
    </div>
  </div>
</section>
<style>
  .storm { background: linear-gradient(180deg, #0c1c2f, #142c47); color: #fff; padding-block: clamp(48px, 6vw, 80px); overflow: hidden; }
  .storm__in { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(24px, 5vw, 64px); align-items: center; }
  @media (max-width: 860px) { .storm__in { grid-template-columns: 1fr; } .storm__art { max-width: 300px; } }
  .storm__copy { display: grid; gap: 16px; justify-items: start; }
  .storm .eyebrow { color: #ff9a70; }
  .storm .lead { color: #d5e0ea; }
  .storm__fine { color: #b8c7d6; font-size: 1rem; }
  .btn--big { font-size: 1.375rem; min-height: 66px; padding-inline: 32px; }
  .storm__cloud { fill: #3b5774; }
  .storm__rain line { stroke: var(--sky); stroke-width: 3; stroke-linecap: round; opacity: .8; }
  .storm__roof { fill: none; stroke: var(--orange); stroke-width: 10; stroke-linecap: round; stroke-linejoin: round; }
  .storm__house { fill: #1d3a5c; stroke: #9cc6e6; stroke-width: 4; }
  .storm__win { fill: #ffd27a; }
  .storm__door { fill: #0c1c2f; stroke: #9cc6e6; stroke-width: 3; }
  .storm__drip { fill: var(--sky); }
  @media (prefers-reduced-motion: no-preference) {
    .storm__rain line { animation: fall var(--s) linear var(--d) infinite; }
    .storm__drip { animation: drip 2.4s ease-in infinite; }
    .storm__win { animation: flicker 5s steps(1) infinite; }
  }
  @keyframes fall { from { translate: 0 -10px; opacity: 0; } 15% { opacity: .9; } to { translate: -8px 70px; opacity: 0; } }
  @keyframes drip { 0%, 30% { translate: 0 0; opacity: 0; } 40% { opacity: 1; } 90% { translate: 0 30px; opacity: 1; } 100% { translate: 0 34px; opacity: 0; } }
  @keyframes flicker { 0%, 92% { opacity: 1; } 94% { opacity: .55; } 96% { opacity: 1; } }
</style>
