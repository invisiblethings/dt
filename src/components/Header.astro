---
import { NAV, LINKS, PRIMARY_CTA } from '../data/site';
interface Props { current: string }
const { current } = Astro.props;
const isCurrent = (href: string) => current === href || current.startsWith(href + '/');
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Pianoforall home">
      <img src="/brand/icon-68.png" alt="" width="34" height="34" />
      <span>Pianoforall</span>
    </a>
    <nav class="main-nav" aria-label="Main">
      <ul>
        {NAV.map((n) => (
          <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="signin" href={LINKS.signIn} data-track="sign_in_click" rel="nofollow">Sign in</a>
      <a class="btn" href={PRIMARY_CTA.href} data-track="cta_click" data-track-location="header">{PRIMARY_CTA.label}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="visually-hidden">Menu</span>
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-open="false">
    <nav class="wrap" aria-label="Mobile">
      <ul>
        <li><a href="/">Home</a></li>
        {NAV.map((n) => (<li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>))}
        <li><a href="/about">About Robin</a></li>
        <li><a href="/faq">FAQ</a></li>
        <li><a href={LINKS.signIn} rel="nofollow">Student sign in</a></li>
      </ul>
      <a class="btn btn-block" href={PRIMARY_CTA.href} data-track="cta_click" data-track-location="mobile_menu">{PRIMARY_CTA.label}</a>
    </nav>
  </div>
</header>
