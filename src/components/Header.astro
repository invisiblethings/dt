---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/brand/logo-white.png';
import { business } from '../data/business';

const nav = [
  { href: '/roofing/roof-replacement/', label: 'Roof replacement' },
  { href: '/roofing/flat-roofing/', label: 'Flat roofing' },
  { href: '/services/', label: 'All services' },
  { href: '/projects/', label: 'Projects' },
  { href: '/service-areas/staten-island/', label: 'Staten Island' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---
<div class="topbar">
  <div class="wrap topbar__in">
    <p><Icon name="drop" /> <span><strong>Leaking right now?</strong> <span class="topbar__long">24/7 emergency service:</span> <a href={business.phoneHref}>{business.phone}</a></span></p>
    <p class="topbar__right"><Icon name="clock" /> {business.responsePromise}</p>
  </div>
</div>
<header class="site-header">
  <div class="wrap site-header__in">
    <a class="brand" href="/" aria-label={`${business.name} home`}>
      <Image quality={72} src={logo} alt="" width={58} height={58} loading="eager" />
      <span class="brand__text"><span>B&amp;B Roofing</span><small>&amp; Gutters · Staten Island</small></span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {nav.map((n) => <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="site-header__cta">
      <a class="phone" href={business.phoneHref}><Icon name="phone" /><span>{business.phone}</span></a>
      <a class="btn btn--primary" href="/free-estimate/">Free estimate</a>
    </div>
    <details class="mnav">
      <summary aria-label="Menu"><Icon name="menu" /><span>Menu</span></summary>
      <div class="mnav__panel">
        <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}<li><a href="/free-estimate/">Free estimate</a></li></ul>
        <a class="btn btn--primary" href={business.phoneHref}><Icon name="phone" /> Call {business.phone}</a>
      </div>
    </details>
  </div>
</header>

<style>
  .topbar { background: var(--orange); color: #fff; font-size: 0.9375rem; }
  .topbar__in { display: flex; justify-content: space-between; gap: 6px 20px; flex-wrap: wrap; padding-block: 7px; }
  .topbar p { display: flex; align-items: center; gap: 8px; }
  .topbar a { color: #fff; font-weight: 700; }
  .topbar svg { width: 18px; height: 18px; }
  @media (max-width: 720px) { .topbar__right, .topbar__long { display: none !important; } }
  .topbar a { white-space: nowrap; }
  .site-header { background: var(--asphalt); color: #fff; }
  .site-header__in { display: flex; align-items: center; gap: 20px; padding-block: 12px; }
  .brand { display: flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; flex: none; }
  .brand__text { display: grid; line-height: 1; font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; }
  .brand__text small { font-family: var(--font-body); font-weight: 600; font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: #b9c4ce; margin-top: 4px; }
  .nav { margin-left: auto; }
  .nav ul { display: flex; gap: 4px; list-style: none; }
  .nav a { color: #e6ebef; text-decoration: none; font-weight: 600; padding: 10px 10px; border-radius: 6px; font-size: 0.98rem; white-space: nowrap; }
  .nav a:hover, .nav a[aria-current='page'] { color: #fff; background: rgba(255,255,255,.08); }
  .nav a[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--orange); }
  .site-header__cta { display: flex; align-items: center; gap: 14px; }
  .site-header__cta { white-space: nowrap; }
  .phone { display: inline-flex; align-items: center; gap: 8px; color: #fff; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .phone svg { width: 20px; color: var(--orange); }
  .mnav { display: none; margin-left: auto; position: relative; }
  .mnav summary { list-style: none; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; padding: 10px 12px; border-radius: 8px; border: 1.5px solid rgba(255,255,255,.4); font-weight: 700; min-height: 48px; }
  .mnav summary::-webkit-details-marker { display: none; }
  .mnav__panel { position: absolute; right: 0; top: calc(100% + 10px); z-index: 50; width: min(86vw, 340px); background: var(--asphalt-2); border-radius: 12px; padding: 14px; box-shadow: var(--shadow); display: grid; gap: 10px; }
  .mnav__panel ul { list-style: none; display: grid; }
  .mnav__panel a:not(.btn) { display: block; color: #fff; text-decoration: none; font-weight: 600; padding: 12px 10px; border-bottom: 1px solid rgba(255,255,255,.08); }
  @media (max-width: 1240px) { .nav { display: none; } .site-header__cta { margin-left: auto; } }
  @media (max-width: 760px) { .site-header__cta { display: none; } .mnav { display: block; } .brand__text small { display: none; } }
</style>
