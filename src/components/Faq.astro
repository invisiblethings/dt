---
// FAQ as native <details>: works without JavaScript, keyboard and screen-reader friendly.
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((it) => (
    <details>
      <summary><span>{it.q}</span><span class="faq__icon" aria-hidden="true"></span></summary>
      <p set:html={it.a} />
    </details>
  ))}
</div>
<style>
  .faq { border-top: 1px solid var(--line); max-width: 860px; }
  details { border-bottom: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 2px; font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; line-height: 1.2; }
  summary::-webkit-details-marker { display: none; }
  .faq__icon { width: 30px; height: 30px; border-radius: 50%; border: 2px solid var(--asphalt); position: relative; flex: none; }
  .faq__icon::before, .faq__icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; background: var(--asphalt); translate: -50% -50%; transition: rotate .2s; }
  .faq__icon::after { rotate: 90deg; }
  details[open] .faq__icon::after { rotate: 0deg; }
  details[open] .faq__icon { background: var(--orange); border-color: var(--orange); }
  details[open] .faq__icon::before, details[open] .faq__icon::after { background: #fff; }
  details p { padding: 0 2px 22px; color: var(--muted); max-width: 70ch; }
</style>
