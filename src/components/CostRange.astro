---
// Market-range calculator: house footprint + roof steepness → rough roof area → published $/sq ft range.
// Uses the HomeBlue Staten Island asphalt range. Clearly labelled as a market estimate, not a quote.
interface Props { low: number; high: number; source: string }
const { low, high, source } = Astro.props;
---
<div class="cr" data-cost data-low={low} data-high={high}>
  <form class="cr__form" onsubmit="return false">
    <div class="field">
      <label for="cr-size">House footprint (sq ft)</label>
      <input id="cr-size" type="number" inputmode="numeric" min="300" max="10000" step="50" value="1200" />
      <span class="hint">The ground floor area, including an attached garage under the same roof.</span>
    </div>
    <fieldset class="cr__pitch">
      <legend>How steep is the roof?</legend>
      <label><input type="radio" name="cr-pitch" value="1.1" /> <span>Low / gentle</span></label>
      <label><input type="radio" name="cr-pitch" value="1.2" checked /> <span>Average</span></label>
      <label><input type="radio" name="cr-pitch" value="1.4" /> <span>Steep</span></label>
    </fieldset>
  </form>
  <div class="cr__out" aria-live="polite">
    <p class="cr__k">Estimated market range</p>
    <p class="cr__range"><span data-out-low>$7,200</span> – <span data-out-high>$11,500</span></p>
    <p class="cr__area">for about <strong data-out-area>1,440</strong> sq ft of roof, at ${low}–${high} per sq ft installed</p>
    <p class="cr__fine">Market estimate based on {source}. Not a B&amp;B quote: tear-off layers, decking repairs, chimneys, skylights and the shingle line all change the price.</p>
    <a class="btn btn--primary" href="/free-estimate/">Get my exact price, free</a>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-cost]').forEach((el) => {
    const low = Number(el.dataset.low), high = Number(el.dataset.high);
    const size = el.querySelector<HTMLInputElement>('#cr-size')!;
    const money = (n: number) => '$' + (Math.round(n / 100) * 100).toLocaleString('en-US');
    const update = () => {
      const pitch = Number(el.querySelector<HTMLInputElement>('input[name="cr-pitch"]:checked')?.value ?? 1.2);
      const area = Math.max(0, Math.min(10000, Number(size.value) || 0)) * pitch;
      el.querySelector('[data-out-area]')!.textContent = Math.round(area).toLocaleString('en-US');
      el.querySelector('[data-out-low]')!.textContent = money(area * low);
      el.querySelector('[data-out-high]')!.textContent = money(area * high);
    };
    el.addEventListener('input', update);
    update();
  });
</script>
<style>
  .cr { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0; border-radius: 20px; overflow: hidden; box-shadow: var(--shadow); border: 1px solid var(--line); }
  @media (max-width: 860px) { .cr { grid-template-columns: 1fr; } }
  .cr__form { background: #fff; padding: clamp(22px, 3vw, 34px); display: grid; gap: 20px; align-content: start; }
  .cr__pitch { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; }
  .cr__pitch legend { font-weight: 700; font-size: 1.0625rem; margin-bottom: 8px; }
  .cr__pitch label { position: relative; display: flex; align-items: center; gap: 10px; min-height: 54px; padding: 10px 16px; border: 2px solid var(--line); border-radius: 12px; font-weight: 600; cursor: pointer; }
  .cr__pitch input { width: 22px; height: 22px; accent-color: var(--orange); }
  .cr__pitch label:has(input:checked) { border-color: var(--orange); background: var(--orange-soft); }
  .cr__out { background: var(--asphalt); color: #fff; padding: clamp(22px, 3vw, 34px); display: grid; gap: 12px; align-content: center; justify-items: start; }
  .cr__k { font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #ff9a70; font-size: .9375rem; }
  .cr__range { font-family: var(--font-display); font-weight: 700; font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem); line-height: 1; font-variant-numeric: tabular-nums; }
  .cr__area { color: #d5e0ea; }
  .cr__fine { color: #b8c7d6; font-size: 1rem; }
</style>
