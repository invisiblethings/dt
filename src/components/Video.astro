---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { vimeoId: string; title: string; poster: ImageMetadata; label?: string; eager?: boolean }
const { vimeoId, title, poster, label, eager = false } = Astro.props;
---
<div class="video" data-vimeo={vimeoId} data-title={title}>
  <Image src={poster} alt="" widths={[480, 800, 1200]} sizes="(min-width: 56rem) 560px, 100vw" loading={eager ? 'eager' : 'lazy'} />
  <button type="button">
    <span class="visually-hidden">Play video: {title}.</span>
    <span class="play" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="#1b1915"/></svg></span>
    {label && <span class="video-label">{label}</span>}
  </button>
</div>
