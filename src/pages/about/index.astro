---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site.js';
import { breadcrumbSchema } from '../../lib/schema.js';

const breadcrumbItems = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];
---
<Layout
  title="About Brooklyn Roof Repair | Licensed Roofing Contractor"
  description="Local, licensed, and insured roof repair contractor serving Brooklyn since 2011 — learn how we diagnose, quote, and repair roofs across the borough."
  path="/about/"
  schema={breadcrumbSchema(breadcrumbItems)}
>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />
      <span class="eyebrow">About Us</span>
      <h1>Brooklyn Roofs Are What We Know</h1>
      <div class="about-grid">
        <div class="about-copy">
          <p>{site.legalName} has repaired and replaced roofs across every neighborhood in Brooklyn since {site.founderYear}. We started because too many homeowners were getting sold replacements they didn't need, or getting patch jobs that failed within a season — so we built the company around a simple standard: diagnose the real problem, quote it honestly, and fix it once.</p>
          <p>Brooklyn's roof stock is genuinely unusual — brownstone flat roofs behind decorative parapets, row houses with shared party walls, pre-war built-up roofing, and a growing number of modern membrane systems on new construction. Working across all of it, block by block, is what our crews do every week.</p>
          <p>We're a licensed and insured NYC home improvement contractor. That means proper permitting on replacement jobs, real liability coverage if something goes wrong, and workmanship warranties you can actually rely on — not just a name on a truck.</p>
        </div>
        <div class="about-stats">
          <div class="stat"><strong>{new Date().getFullYear() - site.founderYear}+</strong><span>Years serving Brooklyn</span></div>
          <div class="stat"><strong>10</strong><span>Neighborhoods with dedicated crews</span></div>
          <div class="stat"><strong>24/7</strong><span>Emergency response</span></div>
          <div class="stat"><strong>100%</strong><span>Licensed &amp; insured work</span></div>
        </div>
      </div>

      <div class="values">
        <h2>How We Work</h2>
        <div class="values-grid">
          <div class="value-card">
            <Icon name="check" size={24} color="#F05A28" />
            <h3>Diagnose Before We Quote</h3>
            <p>Every job starts with a real inspection, not a guess from the street. You get a written cause and a fixed price before any work begins.</p>
          </div>
          <div class="value-card">
            <Icon name="document" size={24} color="#F05A28" />
            <h3>Flat-Rate, In Writing</h3>
            <p>The number we quote is the number you pay. If something changes the scope mid-job, we stop and talk to you before continuing — never after.</p>
          </div>
          <div class="value-card">
            <Icon name="shield" size={24} color="#F05A28" />
            <h3>Repair Over Replace, When Honest</h3>
            <p>We'll tell you when a repair is the smarter financial call, even if a replacement would be the bigger job for us.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <CtaBanner />
</Layout>

<style>
  .about-grid { display: grid; gap: 32px; margin-top: 24px; }
  .about-copy p { color: var(--text-muted); font-size: 1rem; }
  .about-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-content: start; }
  .stat {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 20px;
    text-align: center;
  }
  .stat strong { display: block; font-size: 1.8rem; color: var(--color-navy); font-weight: 800; }
  .stat span { font-size: 0.82rem; color: var(--text-muted); }

  .values { margin-top: 56px; }
  .values-grid { display: grid; gap: 20px; margin-top: 24px; }
  .value-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 24px;
  }
  .value-card h3 { font-size: 1.05rem; margin-block: 14px 8px; }
  .value-card p { color: var(--text-muted); font-size: 0.9rem; margin: 0; }

  @media (min-width: 800px) {
    .about-grid { grid-template-columns: 1.4fr 1fr; }
  }
  @media (min-width: 700px) {
    .values-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
