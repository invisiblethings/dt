---
// Kept at its old URL: email sign-up forms may still send people here.
import Base from '../layouts/Base.astro';
---
<Base title="Thanks for joining" description="You're on the Pianoforall list." noindex>
  <section class="page-hero">
    <div class="wrap-narrow">
      <h1>Thanks for joining</h1>
      <p class="lede">Check your inbox for a welcome email from Robin. If it hasn’t arrived in a few minutes, look in your spam or promotions folder.</p>
      <div class="cta-row">
        <a class="btn" href="/course">See the course</a>
        <a class="btn btn-ghost" href="/learn">Browse the beginner guides</a>
      </div>
    </div>
  </section>
</Base>
