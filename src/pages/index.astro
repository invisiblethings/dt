---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Video from '../components/Video.astro';
import Quote from '../components/Quote.astro';
import FaqList from '../components/FaqList.astro';
import Guarantee from '../components/Guarantee.astro';
import FinalCta from '../components/FinalCta.astro';
import Check from '../components/Check.astro';
import ChordExplorer from '../components/ChordExplorer.astro';
import BuyButton from '../components/BuyButton.astro';
import { PRODUCTS, UDEMY, GUARANTEE_DAYS, LINKS, FEATURES, PRIMARY_CTA } from '../data/site';
import { BOOKS } from '../data/books';
import { byId } from '../data/testimonials';
import { faqsById } from '../data/faqs';
import { faqPage, course, video } from '../lib/schema';

import trailer from '../assets/img/video-trailer.jpg';
import ballad from '../assets/img/video-ballad.jpg';
import playFirst from '../assets/img/how-it-works.jpg';
import robin from '../assets/img/robin-piano.jpg';
import moonlight from '../assets/img/moonlight.jpg';

const pfa = PRODUCTS.pianoforall;
const quotes = byId('bowen', 'derek', 'hoare');
const faqs = faqsById('beginner', 'read-music', 'age', 'vs-youtube', 'keyboard', 'refund');

const schema = [
  course(pfa, 'A step-by-step online piano course for adults. You start with chords and rhythm, learn to play by ear, and learn to read music as you go, through pop, blues, ballads, jazz and classical.'),
  video({ name: 'Pianoforall trailer', description: 'Robin Hall introduces Pianoforall and shows what you play as you work through the course.', vimeoId: LINKS.trailerVimeo, thumbnail: '/og/default.jpg', uploadDate: '2024-06-09', durationSec: 235 }),
  faqPage(faqs),
];
---
<Base
  title="Learn Piano Online: Lessons for Adult Beginners | Pianoforall"
  description={`Pianoforall is a piano course for adults. Start with chords and rhythm, play by ear, and read music as you go. ${pfa.lessons} lessons, $${pfa.price} once, 60-day refund.`}
  path="/"
  schema={schema}
  stickyCta={PRIMARY_CTA}
>
  <!-- 1. Hero: what it is, who it's for, the first step -->
  <section class="hero">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Online piano lessons for adults · since 2006</p>
        <h1>Learn piano by playing piano</h1>
        <p class="lede">Pianoforall starts you on chords and rhythms that sound like real music from the first lesson. You learn to play by ear, then pick up reading as you go. No scales marathon, no children’s songs.</p>
        <div class="cta-row">
          {FEATURES.freeLessons ? (
            <a class="btn btn-lg" href="/free-lessons" data-track="cta_click" data-track-location="hero">Try the free lessons <span class="arrow" aria-hidden="true">→</span></a>
          ) : (
            <BuyButton product="pianoforall" location="hero" variant="btn" size="btn-lg" label={`Get Pianoforall · $${pfa.price}`} />
          )}
          <a class="btn btn-lg btn-ghost" href="/course" data-track="cta_click" data-track-location="hero_secondary">See the full course</a>
        </div>
        <ul class="trust-strip">
          {FEATURES.freeLessons && <li><Check /> No card for the free lessons</li>}
          <li><Check /> ${pfa.price} once, lifetime access</li>
          <li><Check /> {GUARANTEE_DAYS}-day refund</li>
        </ul>
      </div>
      <div class="hero-media">
        <Video vimeoId={LINKS.trailerVimeo} title="Pianoforall trailer" poster={trailer} label="Watch the trailer · 3:55" eager />
      </div>
    </div>
  </section>

  <!-- 2. Proof in numbers people can check -->
  <section class="section-tight" aria-label="Pianoforall in numbers">
    <div class="wrap">
      <div class="stats">
        <div class="stat"><b>2006</b><span>Robin Hall created Pianoforall and still answers student emails himself</span></div>
        <div class="stat"><b>{UDEMY.ratingCount}+</b><span>student ratings, averaging {UDEMY.rating} out of 5</span></div>
        <div class="stat"><b>{pfa.lessons}</b><span>step-by-step lessons with {pfa.videoHours} hours of video</span></div>
        <div class="stat"><b>${pfa.price}</b><span>one payment. No subscription, ever.</span></div>
      </div>
    </div>
  </section>

  <!-- 3. The method in one picture -->
  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">The Pianoforall method</p>
        <h2>Play first. Ask questions later.</h2>
        <p>Traditional lessons start with reading, theory and scales, and most adults give up before they play anything they like. Pianoforall turns that order around.</p>
        <ol class="steps-inline">
          <li><b>Play.</b> You learn a chord shape and a rhythm, and both hands make music in the first lessons.</li>
          <li><b>Learn.</b> Once your hands know the pattern, Robin shows you the chord names, keys and theory behind it.</li>
          <li><b>Understand.</b> The theory sticks, because it explains something you can already play.</li>
        </ol>
        <p>You learn music the way you learned to talk: listening and copying first, reading later.</p>
        <a class="text-link" href="/how-it-works">How the method works</a>
      </div>
      <figure class="figure-frame" style="margin:0">
        <Image src={playFirst} alt="A Pianoforall page: a broken C chord shown on a keyboard diagram under 'Play first', and the same pattern in sheet music under 'Read later'." widths={[480, 760, 916]} sizes="(min-width: 56rem) 520px, 100vw" />
      </figure>
    </div>
  </section>

  <!-- 4. Try it right here -->
  <section class="section section-paper">
    <div class="wrap split top">
      <div>
        <p class="eyebrow">Hear it for yourself</p>
        <h2>Four chords, hundreds of songs</h2>
        <p>C, A minor, F and G turn up in a huge number of pop songs and ballads. In Book 1 you learn them as shapes your hands can find without looking, then play them in different rhythms.</p>
        <p>Tap a chord to see where your hands go and hear how it sounds. Then press play to hear those four chords as a broken-chord pattern, the kind of thing you play early in Book 1.</p>
        <a class="text-link" href="/learn/piano-chords-for-beginners">Learn your first piano chords</a>
      </div>
      <ChordExplorer compact id="try-chords" />
    </div>
  </section>

  <!-- 5. Who it's for -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Who Pianoforall is for</p>
        <h2>Most students recognise themselves in one of these</h2>
      </div>
      <div class="grid grid-2">
        <a class="card card-link" href="/learn/learn-piano-online">
          <h3>You’ve never played</h3>
          <p>You don’t read music and you’re not sure you have “talent”. Book 1 assumes nothing and gets both hands playing from the first lessons.</p>
        </a>
        <a class="card card-link" href="/am-i-too-old-to-learn-piano">
          <h3>You had lessons as a child and quit</h3>
          <p>Scales, exams and pieces you didn’t choose. This time you start with music you like and learn at your own pace.</p>
        </a>
        <a class="card card-link" href="/learn/play-piano-by-ear">
          <h3>You read music but freeze without it</h3>
          <p>Classically trained players use Pianoforall to learn chords, rhythm and playing by ear: the skills their lessons skipped.</p>
        </a>
        <a class="card card-link" href="/course#for-guitarists">
          <h3>You play guitar or sing</h3>
          <p>You already think in chords. Pianoforall shows you the same chords on the keyboard and gives your left hand something to do.</p>
        </a>
      </div>
      <p class="muted small" style="margin-top:1.25rem">Not sure? <a href="/start">Answer four questions</a> and we’ll point you to the right course, or tell you if another option suits you better.</p>
    </div>
  </section>

  <!-- 6. What you get -->
  <section class="section section-sand">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Inside the course</p>
        <h2>Nine books, from your first chord to jazz and Beethoven</h2>
        <p class="lede">Each book adds a style and a skill. Video, audio and keyboard diagrams sit inside the lesson they belong to, so you never juggle files.</p>
      </div>
      <ul class="book-strip" role="list">
        {BOOKS.map((b) => (
          <li>
            <Image src={b.img} alt={`Book ${b.no}: ${b.title}`} widths={[240, 360]} sizes="(min-width: 64rem) 220px, 45vw" loading="lazy" />
            <span><b>Book {b.no}</b> {b.skill}</span>
          </li>
        ))}
      </ul>
      <div class="cta-row" style="margin-top:2rem">
        <a class="btn btn-dark" href="/course" data-track="cta_click" data-track-location="books">See what’s in each book</a>
        <span class="muted small">{pfa.lessons} lessons · {pfa.videoHours} hours of video · audio · printable PDFs · offline ebooks</span>
      </div>
    </div>
  </section>

  <!-- 7. A real lesson -->
  <section class="section">
    <div class="wrap split reverse">
      <div>
        <p class="eyebrow">Watch a real lesson</p>
        <h2>The Amazing Broken Chord Ballad</h2>
        <p>This is a real lesson from the course. Robin starts you with a single bass note in the left hand and a rippling broken chord in the right, then moves the pattern through a chord progression. It sounds much harder than it is, which is the point.</p>
        <p>Every Pianoforall lesson follows the same rhythm: watch, listen, play, then add one new idea.</p>
        <a class="btn" href="/course" data-track="cta_click" data-track-location="sample_lesson">See the whole course</a>
      </div>
      <Video vimeoId={LINKS.sampleLessonVimeo} title="The Amazing Broken Chord Ballad (sample lesson)" poster={ballad} label="Sample lesson · 5:36" />
    </div>
  </section>

  <!-- 8. Proof -->
  <section class="section section-dark">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Students in their own words</p>
        <h2>“Why oh why did I let piano intimidate me for so long?”</h2>
        <p class="lede">Twenty years of emails from students. These are three of them, with their names and towns.</p>
      </div>
      <div class="grid grid-3">
        {quotes.map((t) => <Quote t={t} />)}
      </div>
      <div class="cta-row" style="margin-top:2rem">
        <a class="btn btn-ghost" href="/reviews">Read more student stories</a>
        <span class="rating-badge"><span class="stars" aria-hidden="true">★</span><span><b>{UDEMY.rating}/5</b> from {UDEMY.ratingCount}+ student ratings</span></span>
      </div>
    </div>
  </section>

  <!-- 9. Teacher -->
  <section class="section">
    <div class="wrap split">
      <figure class="figure-frame" style="margin:0">
        <Image src={robin} alt="Robin Hall at his digital piano in his home studio" widths={[400, 600, 800]} sizes="(min-width: 56rem) 480px, 100vw" loading="lazy" />
      </figure>
      <div>
        <p class="eyebrow">Your teacher</p>
        <h2>Robin Hall</h2>
        <p>Robin grew up in his father’s piano shop and has taught piano for more than 30 years. He created Pianoforall in 2006 for adults who wanted to play, not pass exams.</p>
        <p>He is also a published cartoonist and a therapist. You can see both in the course: the explanations lean on pictures and patterns, and he keeps reminding you to relax your shoulders and slow down.</p>
        <p>Email him at <a href="mailto:robin@pianoforall.com">robin@pianoforall.com</a>. He reads every message.</p>
        <a class="text-link" href="/about">More about Robin</a>
      </div>
    </div>
  </section>

  <!-- 10. Progress, honestly -->
  <section class="section section-paper">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What progress looks like</p>
        <h2>Where the course takes you</h2>
        <p class="lede">Robin won’t promise “piano in three weeks”. Everyone moves at a different speed. This is the order you learn things in.</p>
      </div>
      <ol class="grid grid-4 progress-list" role="list">
        <li class="card"><span class="num">1</span><h3>First lessons</h3><p>Chord shapes in both hands and your first rhythm patterns. You play something that sounds like music in your first sitting.</p></li>
        <li class="card"><span class="num">2</span><h3>Books 1–2</h3><p>Fifteen rhythm styles, blues and rock ’n’ roll. You can accompany songs from a chord sheet.</p></li>
        <li class="card"><span class="num">3</span><h3>Books 3–5</h3><p>Inversions, richer chords and ballads. Changes start to flow and you begin improvising your own melodies.</p></li>
        <li class="card"><span class="num">4</span><h3>Books 6–9</h3><p>Jazz, advanced blues, reading sheet music and classical pieces, plus scales in every key.</p></li>
      </ol>
      <p class="muted" style="margin-top:1.5rem">Practise 15 to 30 minutes most days. Short, regular sessions beat long weekend ones. <a href="/learn/how-long-does-it-take-to-learn-piano">How long does it take to learn piano?</a></p>
    </div>
  </section>

  <!-- 11. Classics By Ear -->
  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Classics By Ear</p>
        <h2>Always wanted to play the Moonlight Sonata?</h2>
        <p>Robin’s classical courses teach one piece at a time, the same way: chords and patterns first, then the details. Beethoven’s Moonlight Sonata, Satie’s Gnossiennes and two Bach preludes. You don’t need to read music, and you don’t need to finish Pianoforall first.</p>
        <a class="btn btn-dark" href="/classics-by-ear" data-track="cta_click" data-track-location="home_classics">Explore Classics By Ear</a>
      </div>
      <a href="/classics-by-ear" class="figure-frame" aria-label="Classics By Ear courses">
        <Image src={moonlight} alt="Beethoven Moonlight Sonata, 1st movement: a moonlit lake at night" widths={[480, 800]} sizes="(min-width: 56rem) 480px, 100vw" loading="lazy" />
      </a>
    </div>
  </section>

  <!-- 12. Price + risk reversal -->
  <section class="section section-sand" id="pricing">
    <div class="wrap">
      <div class="split top">
        <div>
          <p class="eyebrow">Price</p>
          <h2>${pfa.price}, once. Yours for life.</h2>
          <p class="lede">All nine books and every future update for one payment. No monthly fee, and nothing locked behind an upgrade.</p>
          <ul class="check-list">
            <li>{pfa.lessons} lessons and {pfa.videoHours} hours of video</li>
            <li>Online course player plus offline ebooks with video and audio built in</li>
            <li>Printable PDFs, keyboard diagrams and audio exercises</li>
            <li>The Piano Lounge student community, and email access to Robin</li>
          </ul>
          <div class="cta-row">
            <BuyButton product="pianoforall" location="home_pricing" size="btn-lg" label={`Get Pianoforall · $${pfa.price}`} />
            <a class="text-link" href="/pricing">All courses and bundles</a>
          </div>
          <p class="cta-note">You can review your order before paying. Checkout by ClickBank.</p>
        </div>
        <Guarantee />
      </div>
    </div>
  </section>

  <!-- 13. Objections -->
  <section class="section">
    <div class="wrap-narrow">
      <h2>Questions people ask before they start</h2>
      <FaqList items={faqs} />
      <p style="margin-top:1.5rem"><a class="text-link" href="/faq">All questions</a></p>
    </div>
  </section>

  <FinalCta location="home_final" />
</Base>

<style>
  .steps-inline { padding-left: 1.2em; margin: 1.25rem 0 1.25rem; }
  .steps-inline li + li { margin-top: .6rem; }
  .book-strip { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 40rem) { .book-strip { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 64rem) { .book-strip { grid-template-columns: repeat(5, 1fr); } .book-strip li:first-child { grid-column: span 1; } }
  .book-strip li { margin: 0; }
  .book-strip img { border-radius: 8px; aspect-ratio: 500/330; object-fit: cover; width: 100%; }
  .book-strip span { display: block; font-size: .9rem; margin-top: .45rem; color: var(--ink-2); line-height: 1.35; }
  .book-strip b { display: block; color: var(--ink); }
  .progress-list { list-style: none; padding: 0; margin: 0; }
  .progress-list li { margin: 0; }
</style>
