---
import Layout from '../layouts/Layout.astro';
import RoofDivider from '../components/RoofDivider.astro';

const services = [
  {
    name: 'Residential Roofing',
    desc: 'Roof replacement, inspections, and repairs built to protect your home for decades.',
    icon: 'M3 11.5L12 4l9 7.5M5 10v9a1 1 0 001 1h12a1 1 0 001-1v-9M9.5 20v-5.5a1 1 0 011-1h3a1 1 0 011 1V20',
    image: '/images/hero-roof.jpg',
  },
  {
    name: 'Commercial Roofing',
    desc: 'Replacements, inspections, and repairs that minimize downtime for your business.',
    icon: 'M4 21V7a1 1 0 011-1h6a1 1 0 011 1v14M13 21V4a1 1 0 011-1h5a1 1 0 011 1v17M4 21h16M7 10h1M7 13h1M7 16h1M16 8h1M16 11h1M16 14h1',
  },
  {
    name: 'Flat Roofing',
    desc: 'TPO, EPDM, and PVC flat roof systems installed and repaired by certified pros.',
    icon: 'M4 8h16M4 8l2-4h12l2 4M4 8v11a1 1 0 001 1h14a1 1 0 001-1V8',
    image: '/images/brooklyn-project.webp',
  },
  {
    name: 'Emergency Roof Repair',
    desc: '24/7 response when a leak or storm damage can’t wait until morning.',
    icon: 'M13 2L4.5 14.5H11L9 22l9.5-13.5H12L13 2z',
  },
  {
    name: 'Skylight Installation',
    desc: 'Skylight installation and repair that brings in light without letting in leaks.',
    icon: 'M12 3v2.5M12 18.5V21M4.5 12H3M21 12h-1.5M6 6l1.5 1.5M18 6l-1.5 1.5M6 18l1.5-1.5M18 18l-1.5-1.5M12 8.5a3.5 3.5 0 100 7 3.5 3.5 0 000-7z',
    image: '/images/replaced-roof-staten-island.jpg',
  },
  {
    name: 'Siding & Gutters',
    desc: 'Vinyl siding and gutter installation and repair to protect every side of your property.',
    icon: 'M4 21V9l8-6 8 6v12M4 21h16M9 21v-6h6v6',
  },
];

const badges = [
  ['/badges/google-guaranteed.png', 'Google Guaranteed'],
  ['/badges/bbb-seal.svg', 'BBB Accredited'],
  ['/badges/gaf-master-elite.png', 'GAF Master Elite'],
  ['/badges/google-5star.png', '5-Star on Google'],
  ['/badges/yelp-rating.png', '5-Star on Yelp'],
  ['/badges/licensed-insured.png', 'Licensed & Insured'],
];

const stats = [
  ['50-Yr', 'Manufacturer warranty available'],
  ['100%', 'Satisfaction guarantee'],
  ['24/7', 'Emergency response'],
  ['5.0★', 'Rated on Google & Yelp'],
];

const steps = [
  {
    title: 'Consultation & Assessment',
    desc: 'Contact us to schedule your assessment. We’ll discuss your needs, thoroughly inspect your roof, and provide an honest evaluation of its condition.',
  },
  {
    title: 'Personalized Solutions & Estimate',
    desc: 'Based on our inspection, we’ll recommend the best roofing solutions for your home or business and provide a detailed, transparent estimate.',
  },
  {
    title: 'Expert Installation or Repair',
    desc: 'Our skilled team meticulously completes your project using premium materials, ensuring it’s done right the first time.',
  },
  {
    title: 'Project Completion & Follow-Up',
    desc: 'We’ll walk you through the finished work, answer any questions, and make sure you’re delighted with your new roof.',
  },
];

const areas = ['Staten Island', 'Brooklyn', 'Manhattan', 'New York City'];

const gallery = [
  ['/images/hero-roof.jpg', 'Residential re-roof, Staten Island'],
  ['/images/replaced-roof-staten-island.jpg', 'Full roof replacement, Staten Island'],
  ['/images/brooklyn-project.webp', 'Roofing project, Brooklyn'],
];
---

<Layout
  title="Alter Phase Roofing Inc. | Roofing, Siding & Gutters in Staten Island & NYC"
  description="Licensed & insured roofing contractor serving Staten Island, Brooklyn, Manhattan and NYC. Free inspections, 24/7 emergency repair, and up to a 50-year warranty."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink-950">
    <div class="absolute inset-0">
      <img src="/images/hero-roof.jpg" alt="" class="h-full w-full object-cover opacity-45" />
      <div class="absolute inset-0 bg-gradient-to-r from-ink-950 via-ink-950/90 to-ink-950/40"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-transparent to-transparent"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-20 lg:pt-28 pb-32 lg:pb-40">
      <p class="inline-flex items-center gap-2 rounded-full border border-copper-400/40 bg-copper-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.15em] text-copper-300">
        Staten Island &middot; Brooklyn &middot; Manhattan &middot; NYC
      </p>
      <h1 class="mt-7 font-display font-semibold text-5xl sm:text-6xl lg:text-7xl text-cream leading-[1.02] text-balance max-w-4xl">
        The roofing company where you&rsquo;re
        <em class="not-italic text-copper-400">more than a job number.</em>
      </h1>
      <p class="mt-7 text-lg text-ink-200 max-w-xl leading-relaxed">
        Residential and commercial roofing, flat roofs, siding, gutters, and 24/7 emergency
        repair &mdash; backed by honest communication, premium materials, and a 100% satisfaction guarantee.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="#contact" class="rounded-full bg-copper-500 px-8 py-4 text-base font-bold text-cream shadow-lift hover:bg-copper-600 transition-colors">
          Get My Free Estimate
        </a>
        <a href="tel:+19293701552" class="rounded-full border border-cream/25 px-8 py-4 text-base font-bold text-cream hover:bg-cream/10 transition-colors">
          Call (929) 370-1552
        </a>
      </div>
    </div>

    <RoofDivider fill="#F3EADA" class="absolute bottom-0 left-0" />
  </section>

  <!-- Marquee trust ticker -->
  <section class="bg-cream-soft py-6 overflow-hidden pause-on-hover">
    <div class="flex w-max animate-marquee gap-16">
      {[...badges, ...badges].map(([src, alt]) => (
        <div class="flex items-center gap-3 opacity-80">
          <img src={src} alt={alt} class="h-10 w-auto object-contain" />
        </div>
      ))}
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="py-24 lg:py-32 bg-cream">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-[0.15em] text-copper-600">What We Do</p>
        <h2 class="mt-4 font-display font-semibold text-4xl sm:text-5xl text-ink-900 text-balance">
          Full-service roofing, siding &amp; gutters
        </h2>
      </div>

      <div class="mt-16 divide-y divide-ink-900/10 border-t border-b border-ink-900/10">
        {services.map((s, i) => (
          <div class="group grid lg:grid-cols-12 gap-6 lg:gap-10 items-center py-10">
            <div class="lg:col-span-1">
              <span class="font-display text-2xl text-ink-300">{`0${i + 1}`}</span>
            </div>
            <div class="lg:col-span-2">
              <span class="flex h-14 w-14 items-center justify-center rounded-full border border-copper-500/30 text-copper-600 group-hover:bg-copper-500 group-hover:text-cream group-hover:border-copper-500 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6">
                  <path d={s.icon} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
            <div class="lg:col-span-6">
              <h3 class="font-display font-semibold text-2xl text-ink-900">{s.name}</h3>
              <p class="mt-2 text-ink-600 leading-relaxed max-w-md">{s.desc}</p>
            </div>
            <div class="lg:col-span-3">
              {s.image && (
                <div class="h-24 w-full rounded-2xl overflow-hidden">
                  <img src={s.image} alt="" class="h-full w-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why us / credentials -->
  <section id="why-us" class="relative bg-ink-950 text-cream">
    <RoofDivider fill="#0C0A07" class="-mt-px" />
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.15em] text-copper-400">Why Homeowners Choose Us</p>
          <h2 class="mt-4 font-display font-semibold text-4xl sm:text-5xl text-balance">
            Decades of combined experience. Zero shortcuts.
          </h2>
          <p class="mt-6 text-ink-300 leading-relaxed max-w-lg">
            We operate on three principles: integrity, craftsmanship, and customer service. That
            means honest evaluations, transparent pricing, and workmanship you can trust &mdash;
            backed by material and workmanship warranties on every job.
          </p>

          <dl class="mt-12 grid sm:grid-cols-2 gap-x-8 gap-y-10">
            {stats.map(([value, label]) => (
              <div>
                <dt class="font-display font-semibold text-4xl text-copper-400">{value}</dt>
                <dd class="mt-2 text-sm text-ink-300 max-w-[16rem]">{label}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="lg:pt-2">
          <div class="rounded-3xl border border-cream/10 bg-cream/5 p-10">
            <p class="font-display font-semibold text-xl">Licensed, Insured &amp; Bonded</p>
            <p class="mt-2 text-ink-400 text-sm">License #2129904-DCWP &mdash; NYC Consumer &amp; Worker Protection</p>
            <div class="mt-8 grid grid-cols-2 gap-4">
              {badges.slice(0, 4).map(([src, alt]) => (
                <div class="flex items-center justify-center rounded-xl bg-cream px-4 py-5">
                  <img src={src} alt={alt} class="h-11 w-auto max-w-full object-contain" />
                </div>
              ))}
            </div>
            <a href="#contact" class="mt-8 block text-center rounded-full bg-copper-500 px-6 py-4 font-bold text-cream hover:bg-copper-600 transition-colors">
              Request My Free Estimate
            </a>
          </div>
        </div>
      </div>
    </div>
    <RoofDivider fill="#FAF4E9" flip class="-mb-px" />
  </section>

  <!-- How we work -->
  <section id="how-we-work" class="py-24 lg:py-32 bg-cream">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-[0.15em] text-copper-600">How We Work</p>
        <h2 class="mt-4 font-display font-semibold text-4xl sm:text-5xl text-ink-900 text-balance">
          From first call to finished roof
        </h2>
      </div>

      <div class="mt-16 relative">
        <div class="absolute left-5 top-2 bottom-2 w-px bg-ink-900/10 hidden sm:block"></div>
        <div class="space-y-12">
          {steps.map((step, i) => (
            <div class="relative flex gap-6 sm:gap-10">
              <span class="relative z-10 flex h-11 w-11 flex-none items-center justify-center rounded-full bg-copper-500 text-cream font-display font-semibold">
                {i + 1}
              </span>
              <div class="pt-1.5">
                <h3 class="font-display font-semibold text-xl text-ink-900">{step.title}</h3>
                <p class="mt-2 text-ink-600 leading-relaxed max-w-xl">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="bg-cream pb-24 lg:pb-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-3 gap-4">
        {gallery.map(([src, caption]) => (
          <div class="group relative aspect-[4/5] rounded-2xl overflow-hidden">
            <img src={src} alt={caption} class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent"></div>
            <p class="absolute bottom-4 left-4 right-4 text-sm font-semibold text-cream">{caption}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Service area -->
  <section id="service-area" class="relative bg-ink-950 text-cream overflow-hidden">
    <RoofDivider fill="#FAF4E9" class="absolute top-0 left-0 rotate-180" />
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 pb-24 lg:pt-20 lg:pb-32 text-center">
      <p class="text-sm font-bold uppercase tracking-[0.15em] text-copper-400">Service Area</p>
      <h2 class="mt-4 font-display font-semibold text-4xl sm:text-5xl text-balance">
        Proudly serving the NYC metro area
      </h2>
      <div class="mt-12 flex flex-wrap justify-center gap-x-3 gap-y-4">
        {areas.map((area, i) => (
          <span class="font-display text-2xl sm:text-3xl text-ink-100">
            {area}{i < areas.length - 1 && <span class="text-copper-500 mx-3">&middot;</span>}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA / Contact -->
  <section id="contact" class="py-24 lg:py-32 bg-cream">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.15em] text-copper-600">Get Started</p>
        <h2 class="mt-4 font-display font-semibold text-4xl sm:text-5xl text-ink-900 text-balance">
          Get a free inspection &amp; estimate
        </h2>
        <p class="mt-5 text-ink-600 leading-relaxed max-w-md">
          Tell us about your project and we&rsquo;ll get back to you with an honest evaluation
          and a transparent estimate &mdash; no pressure, no surprises.
        </p>
        <div class="mt-9 space-y-3 text-sm text-ink-700">
          <p class="font-semibold text-ink-900">61 Appleby Ave, Staten Island, NY 10305</p>
          <p><a href="tel:+19293701552" class="font-bold text-ink-900 hover:text-copper-600">(929) 370-1552</a></p>
          <p>info@alterphaseroofing.com</p>
          <p class="text-ink-500">Mon&ndash;Fri 8AM&ndash;8PM &middot; Sat 8AM&ndash;5PM &middot; Sun Closed</p>
        </div>
      </div>

      <form class="rounded-3xl bg-white border border-ink-900/10 shadow-card p-8 space-y-5">
        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label class="text-sm font-semibold text-ink-700" for="firstName">First Name</label>
            <input id="firstName" name="firstName" type="text" class="mt-1.5 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-copper-400" />
          </div>
          <div>
            <label class="text-sm font-semibold text-ink-700" for="lastName">Last Name</label>
            <input id="lastName" name="lastName" type="text" class="mt-1.5 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-copper-400" />
          </div>
        </div>
        <div>
          <label class="text-sm font-semibold text-ink-700" for="email">Email Address</label>
          <input id="email" name="email" type="email" class="mt-1.5 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-copper-400" />
        </div>
        <div>
          <label class="text-sm font-semibold text-ink-700" for="phone">Phone Number</label>
          <input id="phone" name="phone" type="tel" class="mt-1.5 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-copper-400" />
        </div>
        <div>
          <label class="text-sm font-semibold text-ink-700" for="details">Details</label>
          <textarea id="details" name="details" rows="4" class="mt-1.5 w-full rounded-lg border border-ink-900/15 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-copper-400"></textarea>
        </div>
        <button type="submit" class="w-full rounded-full bg-copper-500 px-6 py-4 font-bold text-cream hover:bg-copper-600 transition-colors">
          Request My Free Estimate
        </button>
      </form>
    </div>
  </section>
</Layout>
