---
import Base from '../layouts/Base.astro';
import { BRAND, LINKS, GUARANTEE_DAYS } from '../data/site';
const schema = [{
  '@type': 'ContactPage',
  mainEntity: {
    '@type': 'Organization', '@id': 'https://pianoforall.com/#organization',
    contactPoint: [
      { '@type': 'ContactPoint', contactType: 'customer support', email: BRAND.email, availableLanguage: 'English' },
      { '@type': 'ContactPoint', contactType: 'billing support', telephone: '+1-800-390-6035', areaServed: ['US', 'CA'], name: 'ClickBank order support' },
    ],
  },
}];
---
<Base
  title="Contact Pianoforall: Course Help and Order Support"
  description="Questions about Pianoforall lessons, downloads or which course to choose? Email Robin Hall directly. For orders and refunds, contact ClickBank."
  crumbs={[{ name: 'Contact', href: '/contact' }]}
  schema={schema}
>
  <section class="page-hero">
    <div class="wrap-narrow">
      <p class="eyebrow">Contact &amp; support</p>
      <h1>Get in touch</h1>
      <p class="lede">For anything about the lessons, email Robin. He reads every message and replies personally.</p>
    </div>
  </section>
  <section class="section-tight" style="padding-top:0">
    <div class="wrap">
      <div class="grid grid-2">
        <div class="card">
          <h2 style="font-size:var(--step-2)">Lessons, downloads and choosing a course</h2>
          <p><a class="btn btn-dark" href={`mailto:${BRAND.email}`} data-track="contact_click" data-track-location="contact_email">{BRAND.email}</a></p>
          <p>For technical help, tell Robin which device you’re using, which book or lesson you’re on, and exactly where the instructions stop working. It saves a round of emails.</p>
          <p class="muted">Students can also ask questions under any lesson in the course player, or in The Piano Lounge.</p>
          <p class="muted">Not sure whether Pianoforall is right for you? Ask Robin, or try the <a href="/start">four-question course finder</a>.</p>
        </div>
        <div class="card">
          <h2 style="font-size:var(--step-2)">Orders, payments and refunds</h2>
          <p>ClickBank is the retailer for all Pianoforall courses and handles payments and refunds.</p>
          <ul>
            <li><a href={LINKS.clickbankSupport} rel="nofollow">ClickBank order support</a></li>
            <li>US and Canada toll free: {LINKS.clickbankPhone}</li>
            <li>International: {LINKS.clickbankPhoneIntl}</li>
          </ul>
          <p>For a refund within {GUARANTEE_DAYS} days, email Robin or request it from ClickBank directly. <a href="/refund-policy">Refund policy</a></p>
          <p class="muted small">Click Sales Inc., 1444 S. Entertainment Ave., Suite 410, Boise, ID 83709, USA</p>
        </div>
      </div>
      <div class="grid grid-3" style="margin-top:2rem">
        <a class="card card-link" href={LINKS.signIn} rel="nofollow"><h3>Student sign in</h3><p class="muted">Go to your course dashboard.</p></a>
        <a class="card card-link" href="/faq"><h3>FAQ</h3><p class="muted">Devices, downloads, access and payments.</p></a>
        <a class="card card-link" href="/affiliate-program"><h3>Affiliates</h3><p class="muted">Share Pianoforall and earn commission.</p></a>
      </div>
    </div>
  </section>
</Base>
