---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EstimateForm from '../components/EstimateForm.astro';
import Icon from '../components/Icon.astro';
import { business, addressLine } from '../data/business';

const href = '/contact/';
const crumbs = [{ name: 'Contact', href }];
const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${business.name}, ${addressLine}`)}`;
---
<Base title="Contact B&B Roofing & Gutters | 145 Cedar Ave, Staten Island" description={`Call ${business.phone}, email or visit our storefront at ${addressLine}. Open ${business.hours}; 24/7 for roof emergencies.`} crumbs={crumbs}>
  <PageHero title="Call, write or stop by" eyebrow="Contact" crumbs={crumbs} trust={false}
    intro="You'll reach a real person at B&B. Our office and storefront is on Cedar Ave, and you're welcome to come in during working hours.">
    <div class="btn-row">
      <a class="btn btn--primary" href={business.phoneHref}><Icon name="phone" /> {business.phone}</a>
      <a class="btn btn--light" href={directions} rel="noopener"><Icon name="pin" /> Get directions</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap contact">
      <div class="stack-lg">
        <dl class="nap">
          <div><dt><Icon name="phone" /> Phone</dt><dd><a href={business.phoneHref}>{business.phone}</a><span>24/7 for active leaks</span></dd></div>
          <div><dt><Icon name="chat" /> Email</dt><dd><a href={`mailto:${business.email}`}>{business.email}</a><span>{business.responsePromise}</span></dd></div>
          <div><dt><Icon name="pin" /> Storefront</dt><dd>{addressLine}<span><a href={directions} rel="noopener">Directions in Google Maps</a></span></dd></div>
          <div><dt><Icon name="clock" /> Hours</dt><dd>{business.hours}<span>Emergency service 24/7</span></dd></div>
        </dl>
        <a class="map" href={directions} rel="noopener" aria-label={`Open ${addressLine} in Google Maps`}>
          <svg viewBox="0 0 600 300" aria-hidden="true" focusable="false">
            <rect width="600" height="300" class="map__land" />
            <path d="M0 220 C150 200 260 260 600 230 V300 H0z" class="map__water" />
            <path d="M40 0 L120 300 M0 90 H600 M0 170 H600 M300 0 L330 300 M470 0 L440 300" class="map__road" />
            <path d="M210 0 L250 300" class="map__road map__road--main" />
            <text x="340" y="160" class="map__label">Cedar Ave</text>
            <g class="map__pin"><path d="M300 150c-22 0-38-17-38-38 0-28 38-66 38-66s38 38 38 66c0 21-16 38-38 38z" /><circle cx="300" cy="110" r="13" /></g>
          </svg>
          <span class="map__cta"><Icon name="pin" /> Open in Google Maps</span>
        </a>
        <p class="muted">Drawing not to scale. Tap it for live directions.</p>
      </div>
      <EstimateForm title="Or send us a message" full />
    </div>
  </section>
</Base>
<style>
  .contact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  @media (max-width: 960px) { .contact { grid-template-columns: 1fr; } }
  .nap { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 0; }
  @media (max-width: 560px) { .nap { grid-template-columns: 1fr; } }
  .nap div { border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; display: grid; gap: 6px; box-shadow: var(--shadow-sm); }
  .nap dt { display: flex; align-items: center; gap: 8px; font-weight: 700; color: var(--muted); font-size: 1rem; text-transform: uppercase; letter-spacing: .05em; }
  .nap dt :global(svg) { width: 22px; height: 22px; color: var(--orange); }
  .nap dd { margin: 0; display: grid; gap: 2px; font-weight: 700; font-size: 1.1875rem; overflow-wrap: anywhere; }
  .nap dd span { font-weight: 400; color: var(--muted); font-size: 1rem; }
  .map { position: relative; display: block; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
  .map svg { display: block; width: 100%; height: auto; }
  .map__land { fill: #eef3ea; }
  .map__water { fill: #cfe6f8; }
  .map__road { stroke: #fff; stroke-width: 10; fill: none; }
  .map__road--main { stroke: #f7d9a8; stroke-width: 16; }
  .map__label { font: 600 16px var(--font-body); fill: #56616c; }
  .map__pin path { fill: var(--orange); stroke: #fff; stroke-width: 4; }
  .map__pin circle { fill: #fff; }
  .map__cta { position: absolute; right: 12px; bottom: 12px; display: inline-flex; align-items: center; gap: 8px; background: #fff; color: var(--asphalt); font-weight: 700; padding: 10px 16px; border-radius: 999px; box-shadow: var(--shadow-sm); }
  .map__cta :global(svg) { width: 20px; height: 20px; color: var(--orange); }
</style>
