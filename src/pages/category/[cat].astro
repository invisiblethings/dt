---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORY_LINKS } from '../../data/blog-map';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const cats = [...new Set(posts.map((p) => p.data.category))];
  return cats.map((cat) => {
    const list = posts.filter((p) => p.data.category === cat).sort((a, b) => +b.data.pubDate - +a.data.pubDate);
    return { params: { cat }, props: { list, name: list[0].data.categoryName } };
  });
}
const { list, name } = Astro.props;
const { cat } = Astro.params;
const related = CATEGORY_LINKS[cat!]?.related ?? [];
---
<Base
  title={`${name}: Articles from Pianoforall`}
  description={`Pianoforall articles about ${name.toLowerCase()}, written by Robin Hall for adult piano learners.`}
  crumbs={[{ name: 'Blog', href: '/blog' }, { name, href: `/category/${cat}` }]}
  noindex={list.length < 3}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Category</p>
      <h1>{name}</h1>
      {related.length > 0 && <p class="lede">Start here: {related.map((r, i) => <>{i > 0 && ' · '}<a href={r.href}>{r.title}</a></>)}</p>}
    </div>
  </section>
  <section class="section-tight" style="padding-top:0">
    <div class="wrap grid grid-3">{list.map((p) => <PostCard post={p} />)}</div>
  </section>
</Base>
