---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EstimateForm from '../components/EstimateForm.astro';
import Icon from '../components/Icon.astro';
import { business, addressLine } from '../data/business';

const href = '/free-estimate/';
const crumbs = [{ name: 'Free estimate', href }];
const next = [
  ['We call you', business.responsePromise],
  ['We visit', 'An owner or estimator inspects the roof, attic and gutters and takes photos.'],
  ['You get options', 'Written repair or replacement options with clear prices and warranty terms.'],
  ['You decide', 'No pressure, no expiring "today only" price.'],
];
---
<Base title="Free Roofing Estimate in Staten Island | B&B Roofing & Gutters" description={`Request a free roofing, flat roof or gutter estimate on Staten Island, in Brooklyn or NJ. ${business.responsePromise} Or call ${business.phone}.`} crumbs={crumbs}>
  <PageHero title="Get your free estimate" eyebrow="Free · no obligation" crumbs={crumbs}
    intro="Tell us a little about your roof. A real person from B&B will get back to you, usually the same day.">
    <ol class="next">{next.map(([t, b], i) => <li><span>{i + 1}</span><div><strong>{t}</strong><p>{b}</p></div></li>)}</ol>
    <EstimateForm slot="side" title="Request your estimate" full />
  </PageHero>

  <section class="section">
    <div class="wrap contact">
      <a class="c" href={business.phoneHref}><Icon name="phone" /><strong>Call</strong><span>{business.phone}</span><small>Emergencies 24/7</small></a>
      <a class="c" href={`mailto:${business.email}`}><Icon name="chat" /><strong>Email</strong><span>{business.email}</span><small>{business.responsePromise}</small></a>
      <a class="c" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${business.name}, ${addressLine}`)}`} rel="noopener"><Icon name="pin" /><strong>Visit</strong><span>{addressLine}</span><small>{business.hours}</small></a>
    </div>
  </section>
</Base>
<style>
  .next { list-style: none; display: grid; gap: 14px; }
  .next li { display: flex; gap: 14px; align-items: flex-start; }
  .next span { flex: none; width: 40px; height: 40px; border-radius: 50%; background: var(--orange); color: #fff; display: grid; place-items: center; font-family: var(--font-display); font-weight: 700; }
  .next p { color: #2f3e4d; }
  .contact { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
  .c { display: grid; gap: 4px; padding: 22px; border: 2px solid var(--line); border-radius: var(--radius); color: inherit; text-decoration: none; overflow-wrap: anywhere; }
  .c:hover { border-color: var(--orange); }
  .c :global(svg) { width: 28px; height: 28px; color: var(--orange); }
  .c strong { font-family: var(--font-display); font-size: 1.375rem; }
  .c span { font-weight: 600; }
  .c small { color: var(--muted); font-size: .9375rem; }
</style>
